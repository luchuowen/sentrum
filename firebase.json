{
  "hosting": {
    "public": "dist",
    "trailingSlash": true,
    "cleanUrls": false,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/api/enquiry",
        "function": {
          "functionId": "submitEnquiry",
          "region": "europe-west4"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.@(woff2|jpg|png|svg|webp|avif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/about.html",
        "destination": "/company/",
        "type": 301
      },
      {
        "source": "/contact.html",
        "destination": "/contact/",
        "type": 301
      },
      {
        "source": "/network-infrastructure.html",
        "destination": "/solutions/networks/structured-cabling/",
        "type": 301
      },
      {
        "source": "/wifi-installation.html",
        "destination": "/solutions/networks/wifi/",
        "type": 301
      },
      {
        "source": "/vsat-installation.html",
        "destination": "/solutions/networks/vsat/",
        "type": 301
      },
      {
        "source": "/access-control.html",
        "destination": "/solutions/security/access-control/",
        "type": 301
      },
      {
        "source": "/intrusion-detection.html",
        "destination": "/solutions/security/intrusion-detection/",
        "type": 301
      },
      {
        "source": "/cyber-security.html",
        "destination": "/solutions/security/cyber-security/",
        "type": 301
      },
      {
        "source": "/unified-communications.html",
        "destination": "/solutions/communications-av/unified-communications/",
        "type": 301
      },
      {
        "source": "/video-wall-installation.html",
        "destination": "/solutions/communications-av/video-walls/",
        "type": 301
      },
      {
        "source": "/audio-visual-system.html",
        "destination": "/solutions/communications-av/audio-visual/",
        "type": 301
      },
      {
        "source": "/server-installation.html",
        "destination": "/solutions/power-data-centre/servers/",
        "type": 301
      },
      {
        "source": "/power-installation.html",
        "destination": "/solutions/power-data-centre/power-ups/",
        "type": 301
      },
      {
        "source": "/fabrication.html",
        "destination": "/solutions/supply-fabrication-support/fabrication/",
        "type": 301
      },
      {
        "source": "/it-equipment.html",
        "destination": "/solutions/supply-fabrication-support/it-equipment/",
        "type": 301
      },
      {
        "source": "/technical-support.html",
        "destination": "/solutions/supply-fabrication-support/technical-support/",
        "type": 301
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}