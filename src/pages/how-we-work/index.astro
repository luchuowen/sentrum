---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
const steps: [string, string, string, string][] = [
  ['Survey', 'We visit the site.', 'An engineer walks the building or site with you. We look at where cables can run, where equipment will sit, what power is available and how each space will be used. For remote sites we also check the view of the sky and where a mast can go.', 'A clear picture of what the site needs.'],
  ['Design', 'We plan it and cost it.', 'We draw up the layout and a bill of quantities — every item and what it costs — and recommend options that fit your budget.', 'A layout and a fully itemised quote.'],
  ['Supply', 'We source the equipment.', 'Equipment comes from established manufacturers through major distributors. Masts, brackets and racks come from our own fabrication floor.', 'The right equipment, without chasing several suppliers.'],
  ['Install', 'Our engineers install it.', 'Our own experienced, qualified engineers do the installation, and we plan around your timelines, including tight ones.', 'One team on site, accountable for the result.'],
  ['Commission', 'We test, set up and train.', 'Every system is tested and configured before handover, and we show your team how to use it.', 'Systems that work on day one, and people who know how to use them.'],
  ['Support', 'We stay on.', 'After go-live, we support the systems we implemented, and advise on what to change as your needs grow — within your budget.', 'A team that already knows your installation.'],
];
---
<Base title="How we work — survey to support" description="Survey, design, supply, install, commission and support — how Sentrum delivers a project with one engineering team from first visit to after go-live.">
<PageHero crumbs={[{ href: '/how-we-work/', label: 'How we work' }]} kicker="How we work" title="One team, from first visit to long after go-live." lede="Most projects involve cabling, equipment, steelwork and power. We handle all of it ourselves, in six clear steps — so you deal with one team, not five contractors." highlight="all" />
<section class="sec" aria-label="The six steps">
  <div class="wrap">
    <ol class="bigsteps">
      {steps.map(([t, s, p, g]) => (
        <li><h2>{t}<small>{s}</small></h2><div><p>{p}</p><dl><dt>You get</dt><dd>{g}</dd></dl></div></li>
      ))}
    </ol>
  </div>
</section>
<section class="sec paper" aria-labelledby="why-h">
  <div class="wrap">
    <header class="sec-head"><div><p class="k">Why one team matters</p><h2 id="why-h">Fewer hand-offs. <span>Fewer surprises.</span></h2></div></header>
    <div class="pillars">
      <div><p class="n">01</p><h3>One point of contact</h3><p>Survey, design, supply, installation and support come from one company. Nothing gets lost between contractors.</p></div>
      <div><p class="n">02</p><h3>No waiting on steel</h3><p>Masts, mounts and racks are made on our own floor, so installs aren’t held up by an outside fabricator.</p></div>
      <div><p class="n">03</p><h3>IT and telecoms together</h3><p>Networks, satellite, security, AV and power are planned as one system, so they work together from the start.</p></div>
    </div>
  </div>
</section>
<CtaBand title="Step one is a visit." accent="Tell us where." />
</Base>
