---
import Base from '../../layouts/Base.astro';
import InnerHero from '../../components/InnerHero.astro';
import SceneBuild from '../../components/SceneBuild.astro';
import CtaBand from '../../components/CtaBand.astro';
const steps: [string, string, string, string][] = [
  ['Survey', 'We visit the site.', 'An engineer walks the building or site with you. We look at where cables can run, where equipment will sit, what power is available and how each space will be used. For remote sites we also check the view of the sky and where a mast can go.', 'A clear picture of what the site needs.'],
  ['Design', 'We plan it and cost it.', 'We draw up the layout and a bill of quantities — every item and what it costs — and recommend options that fit your budget.', 'A layout and a fully itemised quote.'],
  ['Supply', 'We source the equipment.', 'Equipment comes from established manufacturers through major distributors. Masts, brackets and racks come from our own fabrication floor.', 'The right equipment, without chasing several suppliers.'],
  ['Install', 'Our engineers install it.', 'Our own experienced, qualified engineers do the installation, and we plan around your timelines, including tight ones.', 'One team on site, accountable for the result.'],
  ['Commission', 'We test, set up and train.', 'Every system is tested and configured before handover, and we show your team how to use it.', 'Systems that work on day one, and people who know how to use them.'],
  ['Support', 'We stay on.', 'After go-live, we support the systems we implemented, and advise on what to change as your needs grow — within your budget.', 'A team that already knows your installation.'],
];
---
<Base title="How we work — survey to support" description="Survey, design, supply, install, commission and support — how Sentrum delivers a project with one engineering team from first visit to after go-live.">
<InnerHero layout="plain" crumbs={[{ href: '/how-we-work/', label: 'How we work' }]} kicker="How we work" title="Six steps. <em>One team the whole way.</em>" lede="Most projects involve cabling, equipment, steelwork and power. We handle all of it ourselves — scroll down and watch a building go from first visit to fully supported." cta={null} ghost={{ href: '#steps', label: 'Start at step one ↓' }} />
<div class="ih-tick" aria-hidden="true"><div class="wrap">{steps.map(([t], i) => <span><b>0{i + 1}</b>{t}</span>)}</div></div>

<section class="story" id="steps" aria-label="The six steps">
  <div class="wrap story-in">
    <div class="story-art"><div class="story-stick"><SceneBuild /><p class="story-ro"><span id="hw-n">01</span> / 06 · <span id="hw-t">Survey</span></p></div></div>
    <ol class="story-steps">
      {steps.map(([t, s, p, g], i) => (
        <li data-s={i + 1}>
          <p class="st-n">0{i + 1}</p>
          <h2>{t}<small>{s}</small></h2>
          <p>{p}</p>
          <p class="st-get"><span>You get</span>{g}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="sec why3" aria-labelledby="why-h">
  <div class="wrap">
    <header class="sec-head"><div><p class="k">Why one team matters</p><h2 id="why-h">Fewer hand-offs. <span>Fewer surprises.</span></h2></div></header>
    <ol class="big3">
      <li><b>One point of contact</b><p>Survey, design, supply, installation and support come from one company. Nothing gets lost between contractors.</p></li>
      <li><b>No waiting on steel</b><p>Masts, mounts and racks are made on our own floor, so installs aren’t held up by an outside fabricator.</p></li>
      <li><b>IT and telecoms together</b><p>Networks, satellite, security, AV and power are planned as one system, so they work together from the start.</p></li>
    </ol>
  </div>
</section>
<CtaBand title="Step one is a visit." accent="Tell us where." />
<script is:inline>
(()=>{const svg=document.getElementById('hw'),items=[...document.querySelectorAll('.story-steps li')],n=document.getElementById('hw-n'),t=document.getElementById('hw-t');
const set=li=>{const s=li.dataset.s;svg.setAttribute('data-s',s);n.textContent='0'+s;t.textContent=li.querySelector('h2').firstChild.textContent;items.forEach(x=>x.classList.toggle('on',x===li))};
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)set(e.target)}),{rootMargin:'-45% 0px -45% 0px'});items.forEach(li=>io.observe(li));set(items[0])})();
</script>
</Base>
