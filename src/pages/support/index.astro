---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { company } from '../../data/site';
---
<Base title="Technical support" description="Support for systems Sentrum installed — faults, repairs, changes and upgrades from the engineers who know your installation. Call +254 720 288 713 or email info@sentrumcoms.net.">
<PageHero crumbs={[{ href: '/support/', label: 'Support' }]} kicker="Support" title="Something not working? Tell us — we support what we install." lede="Call or send a support request. Describe what’s happening in your own words; no technical terms needed." cta={{ href: `tel:${company.tel}`, label: `Call ${company.phone}` }} ghost={{ href: '/contact/?topic=support', label: 'Send a support request' }} highlight="steel" />
<section class="sec" aria-labelledby="tell-h">
  <div class="wrap split">
    <div><p class="k">To help us help you faster</p><h2 id="tell-h" class="h2">Five things to tell us.</h2><p style="color:var(--ink-2);margin-top:14px;max-width:40ch">You don’t need technical words. Describe what you see, the way you’d explain it to a colleague.</p></div>
    <ol class="next" style="margin-top:0">
      <li><span><b>Your organisation and site</b> — which building or location.</span></li>
      <li><span><b>Which system</b> — WiFi, phones, a door reader, the screens, the satellite link…</span></li>
      <li><span><b>What happened, and when</b> — and whether it’s still happening.</span></li>
      <li><span><b>What you’ve already tried</b> — a restart, a different cable, another room.</span></li>
      <li><span><b>How to reach you</b> — the best number and a person on site.</span></li>
    </ol>
  </div>
</section>
<section class="sec paper" aria-labelledby="oth-h">
  <div class="wrap">
    <div class="tender">
      <div><h3 id="oth-h">Installed by someone else?</h3><p>Tell us what you have and we’ll let you know whether we can help.</p></div>
      <a class="cta" href="/contact/?topic=support">Describe your system</a>
    </div>
  </div>
</section>
</Base>
