---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { areas, areaUrl, serviceUrl } from '../data/services';
import { brands, process } from '../data/site';
import fs from 'node:fs';
// Technology marks: drop an official monochrome SVG at public/brands/<slug>.svg and the orbit uses it; otherwise the name is set as text.
const brandSlug = (b: string) => b.toLowerCase().replace(/[^a-z0-9]/g, '');
const marks = brands.map((b) => { const f = `public/brands/${brandSlug(b)}.svg`; if (!fs.existsSync(f)) return { name: b, svg: '', wide: false };
  const svg = fs.readFileSync(f, 'utf8'), vb = (svg.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 1 1').split(' ').map(Number);
  return { name: b, svg, wide: vb[2] / vb[3] > 2.5 }; });
// "What we deliver": one line and one line-glyph per system (48x48, stroke = currentColor).
const glyph: Record<string, { line: string; title: string; svg: string }> = {
  networks: { line: 'Cabling, fibre,<br>WiFi and VSAT.', title: 'Networks &amp;<br>Connectivity', svg: '<path d="M8 20a22 22 0 0 1 32 0M14 26a13.5 13.5 0 0 1 20 0M20 32a5.5 5.5 0 0 1 8 0"/><circle cx="24" cy="38" r="1.6" fill="currentColor" stroke="none"/>' },
  security: { line: 'Access control,<br>intrusion and cyber.', title: 'Security<br>Systems', svg: '<path d="M24 6l14 5v11c0 9-6 16-14 20-8-4-14-11-14-20V11z"/><circle cx="24" cy="21" r="3.2"/><path d="M24 24.2V30"/>' },
  'communications-av': { line: 'Unified comms,<br>video walls and AV.', title: 'Communications<br>&amp; AV', svg: '<rect x="6" y="9" width="36" height="23" rx="2"/><path d="M24 32v7M16 39h16M13 21h5l3-5 4 10 3-5h7"/>' },
  'power-data-centre': { line: 'Servers, UPS<br>and electrical.', title: 'Power &amp;<br>Data Centre', svg: '<rect x="12" y="6" width="24" height="36" rx="2"/><path d="M12 18h24M12 30h24M24 12h7M24 24h7M24 36h7"/><circle cx="17.5" cy="12" r="1.2" fill="currentColor" stroke="none"/><circle cx="17.5" cy="24" r="1.2" fill="currentColor" stroke="none"/><circle cx="17.5" cy="36" r="1.2" fill="currentColor" stroke="none"/>' },
  'supply-fabrication-support': { line: 'Equipment, masts<br>and aftercare.', title: 'Supply &amp;<br>Support', svg: '<path d="M24 14v28M16 42l8-28 8 28M18.5 33h11M20.6 25h6.8M18 9a8.5 8.5 0 0 1 12 0M14.5 5.5a13.5 13.5 0 0 1 19 0"/>' },
};
const net = areas[0], av = areas[2];
---
<Base title="Sentrum — networks, satellite, security, AV & power in Kenya" description="Nairobi systems integrator. Structured cabling, WiFi, VSAT, access control, cyber security, AV, servers and power — installed and supported by one engineering team across Kenya and Africa.">
<Hero />

<section class="sys" aria-labelledby="sys-h">
  <div class="wrap">
    <header class="sec-head">
      <div><p class="k">What we deliver</p><h2 id="sys-h">Five systems, <span>built to work as one.</span></h2></div>
      <a class="more" href="/solutions/">All services <span aria-hidden="true">→</span></a>
    </header>
    <ul class="gl">
      {areas.map((a, i) => (
        <li><a href={areaUrl(a)} class={i === 0 ? 'on' : undefined} style={`--im:url(${a.img})`}>
          <span class="gl-ph" aria-hidden="true"></span>
          <span class="gl-top" aria-hidden="true"><span class="n">{String(i + 1).padStart(2, '0')}</span><i>→</i></span>
          <svg viewBox="0 0 48 48" aria-hidden="true" set:html={glyph[a.slug].svg}></svg>
          <span class="gl-b"><b set:html={glyph[a.slug].title}></b><em set:html={glyph[a.slug].line}></em></span>
        </a></li>
      ))}
    </ul>
  </div>
</section>

<section class="remote" aria-labelledby="rem-h">
  <div class="wrap rg">
    <div class="rtext">
      <p class="k">Remote &amp; satellite</p>
      <h2 id="rem-h">Hours from the nearest fibre? The link, the mast and the power come from us.</h2>
      <p class="lead">Internet by satellite for sites that cables and mobile networks don’t reach — one site or rollouts across several countries.</p>
      <dl class="spec">
        <div><dt>Platforms</dt><dd>iDirect · SkyEdge · Comtech</dd></div>
        <div><dt>Links</dt><dd>Shared or dedicated, incl. TV broadcast</dd></div>
        <div><dt>Dishes</dt><dd>Small site dishes to large ground stations</dd></div>
        <div><dt>Power</dt><dd>Backup batteries (UPS) and solar</dd></div>
      </dl>
      <a class="cta" href="/remote-and-satellite/">How remote sites work →</a>
    </div>
    <figure class="rbig marks">
      <img src="/img/remote-site.jpg" alt="VSAT dish on a lattice mast beside a solar array at a remote site" loading="lazy" width="1600" height="900">
      <svg class="uplink" viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true"><path d="M44 18 C 60 6, 80 2, 100 0"/></svg>
    </figure>
    <figure class="rsmall marks">
      <img src="/img/rooftop-vsat.jpg" alt="Technician aligning a VSAT dish on a rooftop mount" loading="lazy" width="960" height="1200">
      <figcaption><b>Mounts made in-house</b> Masts, dish and rack frames from our own floor.</figcaption>
    </figure>
  </div>
</section>

<section class="env" aria-labelledby="env-h">
  <div class="wrap">
    <header class="sec-head"><div><p class="k">Where we work</p><h2 id="env-h">Built for the rooms and sites organisations can’t afford to lose.</h2></div></header>
    <div class="cards">
      <a class="card" href={areaUrl(net)}><img src="/img/env-office.jpg" alt="" loading="lazy" width="1200" height="900"><span class="cbody"><b>Offices &amp; HQs</b><span>Cabling, WiFi, door access</span></span><i aria-hidden="true">→</i></a>
      <a class="card" href={serviceUrl(av, av.services[1])}><img src="/img/env-control.jpg" alt="" loading="lazy" width="1200" height="900"><span class="cbody"><b>Control rooms</b><span>Video walls, AV, backup power</span></span><i aria-hidden="true">→</i></a>
      <a class="card" href={serviceUrl(av, av.services[2])}><img src="/img/env-campus.jpg" alt="" loading="lazy" width="1200" height="900"><span class="cbody"><b>Campuses</b><span>Projection, sound, networks</span></span><i aria-hidden="true">→</i></a>
      <a class="card" href="/remote-and-satellite/"><img src="/img/env-teleport.jpg" alt="" loading="lazy" width="1200" height="900"><span class="cbody"><b>Broadcast &amp; telecoms</b><span>Satellite links, large dishes</span></span><i aria-hidden="true">→</i></a>
    </div>
  </div>
</section>

<section class="proc" aria-labelledby="proc-h">
  <div class="wrap pr">
    <div class="pr-h"><p class="k">How we work</p><h2 id="proc-h">The same team, from first survey to support.</h2><a class="more" href="/how-we-work/">The full process <span aria-hidden="true">→</span></a></div>
    <div class="pr-stage">
      <div class="pr-row">
        <div class="pr-odo" aria-hidden="true"><span class="z">0</span><span class="roll"><span class="strip">{process.map((_, i) => <span>{i + 1}</span>)}</span></span></div>
        <div class="pr-tx" aria-live="polite">{process.map(([t, d], i) => <div class={i === 0 ? 'ts on' : 'ts'}><h3>{t}</h3><p>{d}</p></div>)}</div>
      </div>
      <ol class="pr-seg">{process.map(([t], i) => <li><button type="button" data-i={i} aria-label={`Step ${i + 1}: ${t}`} class={i === 0 ? 'on' : undefined}><i></i><span>{String(i + 1).padStart(2, '0')}</span></button></li>)}</ol>
    </div>
  </div>
</section>

<section class="proof" aria-labelledby="proof-h">
  <div class="wrap co">
    <div class="co-l">
      <p class="k">The company</p>
      <h2 id="proof-h">Sentrum Communication &amp; Technologies Ltd</h2>
      <p class="co-lede">A Nairobi-based systems integrator, working across Kenya and Africa.</p>
      <dl class="co-facts">
        <div><dt>Head office</dt><dd>Wilson Airport, Block 34</dd></div>
        <div><dt>Services</dt><dd>14, one contract</dd></div>
        <div><dt>Team experience</dt><dd>15+ years</dd></div>
      </dl>
      <a class="more" href="/company/">About the company <span aria-hidden="true">→</span></a>
    </div>
    <figure class="orb">
      <p class="orb-k">Technologies we work with</p>
      <div class="orb-stage">
        <div class="orb-disk" aria-hidden="true"><span class="orb-sweep"></span><i class="o1"></i><i class="o2"></i><i class="o3"></i><span class="orb-blip"></span></div>
        <ul class="orb-l" aria-label="Technologies we work with">
          {marks.map((m) => m.svg
            ? <li class={m.wide ? "orb-p has-logo wide" : "orb-p has-logo"} tabindex="0" aria-label={m.name}><span class="orb-logo" set:html={m.svg}></span><span class="orb-tip" aria-hidden="true">{m.name}</span></li>
            : <li class="orb-p"><span class="orb-name">{m.name}</span></li>)}
        </ul>
      </div>
      <figcaption><span class="mono">1.3204° S · 36.8127° E</span><span>Wilson Airport, Nairobi</span></figcaption>
    </figure>
  </div>
  <div class="wrap">
    <p class="co-note">Brand names and marks are trademarks of their owners.</p>
    <div class="co-tender"><p><b>Preparing a tender?</b> Ask for our company profile and registration documents.</p><a class="cta" href="/contact/?topic=profile">Request company profile <span aria-hidden="true">→</span></a></div>
  </div>
</section>

<script is:inline>
/* Technologies orbit: marks ride three rings around the head office; the radar sweep lights each one as it passes.
   Hover/focus pauses everything; off-screen, hidden tab and reduced motion stop it. Phones get a static list. */
(()=>{const st=document.querySelector('.orb-stage');if(!st)return;const ps=[...st.querySelectorAll('.orb-p')],sw=st.querySelector('.orb-sweep'),RM=matchMedia('(prefers-reduced-motion: reduce)').matches,wide=matchMedia('(min-width:761px)');
const R=[{r:.22,n:6,P:95,d:1,o:.2},{r:.32,n:9,P:125,d:-1,o:.6},{r:.42,n:11,P:160,d:1,o:0}],SW=6,TAU=Math.PI*2;
let k=0;const P=ps.map((el,i)=>{let g=0,c=i;while(c>=R[g].n){c-=R[g].n;g++}return{el,ring:R[g],b:c/R[g].n*TAU+R[g].o,i}});
let t=0,last=0,raf=0,vis=false,held=false,born=0;
const place=()=>{const s=(t/SW%1)*TAU;sw.style.transform=`rotate(${s}rad)`;const now=performance.now();
  P.forEach(p=>{const e=born?Math.min(1,Math.max(0,(now-born-p.i*45)/1100)):RM?1:0,ee=1-Math.pow(1-e,3),a=p.b+p.ring.d*TAU*t/p.ring.P,rr=p.ring.r*ee;
    p.el.style.left=(50+rr*100*Math.sin(a))+'%';p.el.style.top=(50-rr*100*Math.cos(a))+'%';p.el.style.opacity=ee;
    let d=(s-((a%TAU)+TAU)%TAU+TAU)%TAU,g=Math.max(0,1-d/1.3);p.el.style.setProperty('--g',(RM?0:g).toFixed(3))})};
const frame=ts=>{const dt=last?Math.min(.05,(ts-last)/1000):0;last=ts;if(!held)t+=dt;place();raf=(vis&&!document.hidden&&!RM&&wide.matches)?requestAnimationFrame(frame):0;if(!raf)last=0};
const go=()=>{if(!wide.matches){ps.forEach(p=>{p.style.left=p.style.top=p.style.opacity=''});return}if(RM){place();return}if(!raf&&vis&&!document.hidden)raf=requestAnimationFrame(frame)};
ps.forEach(p=>{p.addEventListener('pointerenter',()=>{held=true;st.classList.add('held')});p.addEventListener('pointerleave',()=>{held=false;st.classList.remove('held')});
  p.addEventListener('focus',()=>{held=true;st.classList.add('held')});p.addEventListener('blur',()=>{held=false;st.classList.remove('held')})});
new IntersectionObserver(([e])=>{vis=e.isIntersecting;if(vis&&!born)born=performance.now();go()},{threshold:.3}).observe(st);
document.addEventListener('visibilitychange',go);wide.addEventListener('change',go);if(wide.matches)place()})();
</script>
<script is:inline>
/* How we work: an odometer counter steps through the six stages (3.4 s each) while on screen. Click a bar to jump; hover holds. Reduced motion: no autoplay. */
(()=>{const r=document.querySelector('.pr-stage');if(!r)return;const st=r.querySelector('.strip'),ts=[...r.querySelectorAll('.ts')],bs=[...r.querySelectorAll('.pr-seg button')],D=3400,RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
let i=0,t=0,vis=false,held=false;
const set=k=>{i=(k+6)%6;st.style.setProperty('--i',i);ts.forEach((s,j)=>s.classList.toggle('on',j===i));bs.forEach((b,j)=>{b.classList.toggle('on',j===i);b.classList.toggle('done',j<i);b.setAttribute('aria-current',j===i?'step':'false');const x=b.firstElementChild;x.style.animation='none';void x.offsetWidth;x.style.animation=''})};
const run=()=>{clearTimeout(t);r.classList.toggle('held',held||RM);if(RM||held||!vis||document.hidden)return;t=setTimeout(()=>{set(i+1);run()},D)};
bs.forEach((b,k)=>b.addEventListener('click',()=>{set(k);run()}));
r.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'){held=true;run()}});r.addEventListener('pointerleave',()=>{held=false;run()});
r.addEventListener('focusin',()=>{held=true;run()});r.addEventListener('focusout',e=>{if(!r.contains(e.relatedTarget)){held=false;run()}});
new IntersectionObserver(([e])=>{const was=vis;vis=e.isIntersecting;if(vis&&!was)set(i);run()},{threshold:.4}).observe(r);document.addEventListener('visibilitychange',run);set(0)})();
</script>
<script is:inline>
/* What we deliver: light one column at a time (3.6 s each) so the grid never sits idle. Hover/focus takes over; off-screen, hidden tab,
   phones and reduced motion stop the cycle (reduced motion keeps column 1 lit). */
(()=>{const g=document.querySelector('.gl');if(!g)return;const as=[...g.querySelectorAll('a')],D=3600,RM=matchMedia('(prefers-reduced-motion: reduce)').matches,wide=matchMedia('(min-width:981px)');
let i=0,t=0,held=false,vis=false;
const set=k=>{i=(k+as.length)%as.length;as.forEach((a,j)=>a.classList.toggle('on',j===i))};
const run=()=>{clearTimeout(t);g.classList.toggle('held',held||RM);if(RM||held||!vis||document.hidden||!wide.matches)return;
  const a=as[i];a.classList.remove('on');void a.offsetWidth;a.classList.add('on');t=setTimeout(()=>{set(i+1);run()},D)};
as.forEach((a,k)=>{a.addEventListener('pointerenter',e=>{if(e.pointerType!=='mouse')return;held=true;set(k);run()});
  a.addEventListener('focus',()=>{held=true;set(k);run()});
  a.addEventListener('pointerleave',e=>{if(e.pointerType!=='mouse')return;held=false;run()});a.addEventListener('blur',()=>{held=false;run()})});
new IntersectionObserver(([e])=>{vis=e.isIntersecting;run()},{threshold:.4}).observe(g);
document.addEventListener('visibilitychange',run);wide.addEventListener('change',run);})();
</script>
</Base>
