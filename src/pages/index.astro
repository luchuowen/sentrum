---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import { areas, areaUrl, serviceUrl } from '../data/services';
import { brands, process } from '../data/site';
// "What we deliver": one line and one line-glyph per system (48x48, stroke = currentColor).
const glyph: Record<string, { line: string; svg: string }> = {
  networks: { line: 'Cabling, fibre, WiFi and VSAT.', svg: '<path d="M8 20a22 22 0 0 1 32 0M14 26a13.5 13.5 0 0 1 20 0M20 32a5.5 5.5 0 0 1 8 0"/><circle cx="24" cy="38" r="1.6" fill="currentColor" stroke="none"/>' },
  security: { line: 'Access control, intrusion and cyber.', svg: '<path d="M24 6l14 5v11c0 9-6 16-14 20-8-4-14-11-14-20V11z"/><circle cx="24" cy="21" r="3.2"/><path d="M24 24.2V30"/>' },
  'communications-av': { line: 'Unified comms, video walls and AV.', svg: '<rect x="6" y="9" width="36" height="23" rx="2"/><path d="M24 32v7M16 39h16M13 21h5l3-5 4 10 3-5h7"/>' },
  'power-data-centre': { line: 'Servers, UPS and electrical.', svg: '<rect x="12" y="6" width="24" height="36" rx="2"/><path d="M12 18h24M12 30h24M24 12h7M24 24h7M24 36h7"/><circle cx="17.5" cy="12" r="1.2" fill="currentColor" stroke="none"/><circle cx="17.5" cy="24" r="1.2" fill="currentColor" stroke="none"/><circle cx="17.5" cy="36" r="1.2" fill="currentColor" stroke="none"/>' },
  'supply-fabrication-support': { line: 'Equipment, masts and aftercare.', svg: '<path d="M24 14v28M16 42l8-28 8 28M18.5 33h11M20.6 25h6.8M18 9a8.5 8.5 0 0 1 12 0M14.5 5.5a13.5 13.5 0 0 1 19 0"/>' },
};
const net = areas[0], av = areas[2];
---
<Base title="Sentrum — networks, satellite, security, AV & power in Kenya" description="Nairobi systems integrator. Structured cabling, WiFi, VSAT, access control, cyber security, AV, servers and power — installed and supported by one engineering team across Kenya and Africa.">
<Hero />

<section class="sys" aria-labelledby="sys-h">
  <div class="wrap">
    <header class="sec-head">
      <div><p class="k">What we deliver</p><h2 id="sys-h">Five systems. <span>One accountable team.</span></h2></div>
      <a class="more" href="/solutions/">All 14 services <span aria-hidden="true">→</span></a>
    </header>
    <ul class="gl">
      {areas.map((a, i) => (
        <li><a href={areaUrl(a)} class={i === 0 ? 'on' : undefined} style={`--im:url(${a.img})`}>
          <span class="gl-ph" aria-hidden="true"></span>
          <span class="gl-top" aria-hidden="true"><span class="n">{String(i + 1).padStart(2, '0')}</span><i>→</i></span>
          <svg viewBox="0 0 48 48" aria-hidden="true" set:html={glyph[a.slug].svg}></svg>
          <span class="gl-b"><b>{a.name}</b><em>{glyph[a.slug].line}</em></span>
        </a></li>
      ))}
    </ul>
  </div>
</section>

<section class="remote" aria-labelledby="rem-h">
  <div class="wrap rg">
    <div class="rtext">
      <p class="k">Remote &amp; satellite</p>
      <h2 id="rem-h">Hours from the nearest fibre? The link, the mast and the power come from us.</h2>
      <p class="lead">Internet by satellite for sites that cables and mobile networks don’t reach — one site or rollouts across several countries.</p>
      <dl class="spec">
        <div><dt>Platforms</dt><dd>iDirect · SkyEdge · Comtech</dd></div>
        <div><dt>Links</dt><dd>Shared or dedicated, incl. TV broadcast</dd></div>
        <div><dt>Dishes</dt><dd>Small site dishes to large ground stations</dd></div>
        <div><dt>Power</dt><dd>Backup batteries (UPS) and solar</dd></div>
      </dl>
      <a class="cta" href="/remote-and-satellite/">How remote sites work →</a>
    </div>
    <figure class="rbig marks">
      <img src="/img/remote-site.jpg" alt="VSAT dish on a lattice mast beside a solar array at a remote site" loading="lazy" width="1600" height="900">
      <svg class="uplink" viewBox="0 0 100 60" preserveAspectRatio="none" aria-hidden="true"><path d="M44 18 C 60 6, 80 2, 100 0"/></svg>
    </figure>
    <figure class="rsmall marks">
      <img src="/img/rooftop-vsat.jpg" alt="Technician aligning a VSAT dish on a rooftop mount" loading="lazy" width="960" height="1200">
      <figcaption><b>Mounts made in-house</b> Masts, dish and rack frames from our own floor.</figcaption>
    </figure>
  </div>
</section>

<section class="env" aria-labelledby="env-h">
  <div class="wrap">
    <header class="sec-head"><div><p class="k">Where we work</p><h2 id="env-h">Built for the rooms and sites organisations can’t afford to lose.</h2></div></header>
    <div class="cards">
      <a class="card" href={areaUrl(net)}><img src="/img/env-office.jpg" alt="" loading="lazy" width="1200" height="900"><span class="cbody"><b>Offices &amp; headquarters</b><span>Cabling, WiFi, phones, door access</span></span></a>
      <a class="card" href={serviceUrl(av, av.services[1])}><img src="/img/env-control.jpg" alt="" loading="lazy" width="1200" height="900"><span class="cbody"><b>Control &amp; situation rooms</b><span>Video walls, AV, backup power</span></span></a>
      <a class="card" href={serviceUrl(av, av.services[2])}><img src="/img/env-campus.jpg" alt="" loading="lazy" width="1200" height="900"><span class="cbody"><b>Campuses &amp; lecture halls</b><span>Projection, sound, networks</span></span></a>
      <a class="card" href="/remote-and-satellite/"><img src="/img/env-teleport.jpg" alt="" loading="lazy" width="1200" height="900"><span class="cbody"><b>Service providers &amp; broadcast</b><span>Dedicated satellite links, large dishes</span></span></a>
    </div>
  </div>
</section>

<section class="proc" aria-labelledby="proc-h">
  <div class="wrap">
    <header class="sec-head"><div><p class="k">How we work</p><h2 id="proc-h">The same team, from first survey to support.</h2></div><a class="more" href="/how-we-work/">The full process <span aria-hidden="true">→</span></a></header>
    <ol>{process.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}</ol>
  </div>
</section>

<section class="proof" aria-labelledby="proof-h">
  <div class="wrap pg">
    <div class="about">
      <p class="k">The company</p>
      <h2 id="proof-h">Sentrum Communication &amp; Technologies Ltd</h2>
      <p>A Nairobi-based systems integrator, working across Kenya and Africa.</p>
      <dl class="tb">
        <div class="wide"><dt>Head office</dt><dd>Wilson Airport, Block 34, Nairobi</dd></div>
        <div><dt>Services</dt><dd>14, under one contract</dd></div>
        <div><dt>Team experience</dt><dd>Over 15 years</dd></div>
        <div class="wide"><dt>Position</dt><dd class="mono">1.3204° S · 36.8127° E</dd></div>
      </dl>
      <p style="margin-top:24px"><a class="more" href="/company/">About the company <span aria-hidden="true">→</span></a></p>
    </div>
    <div class="techbox">
      <p class="k">Technologies we work with</p>
      <ul class="brandcols">{brands.map((b) => <li>{b}</li>)}</ul>
      <p class="note">Brand names are trademarks of their owners.</p>
    </div>
    <div class="tender">
      <div><h3>Preparing a tender?</h3><p>Ask for our company profile and registration documents.</p></div>
      <a class="cta" href="/contact/?topic=profile">Request company profile</a>
    </div>
  </div>
</section>

<CtaBand />
<script is:inline>
/* What we deliver: light one column at a time (3.6 s each) so the grid never sits idle. Hover/focus takes over; off-screen, hidden tab,
   phones and reduced motion stop the cycle (reduced motion keeps column 1 lit). */
(()=>{const g=document.querySelector('.gl');if(!g)return;const as=[...g.querySelectorAll('a')],D=3600,RM=matchMedia('(prefers-reduced-motion: reduce)').matches,wide=matchMedia('(min-width:981px)');
let i=0,t=0,held=false,vis=false;
const set=k=>{i=(k+as.length)%as.length;as.forEach((a,j)=>a.classList.toggle('on',j===i))};
const run=()=>{clearTimeout(t);g.classList.toggle('held',held||RM);if(RM||held||!vis||document.hidden||!wide.matches)return;
  const a=as[i];a.classList.remove('on');void a.offsetWidth;a.classList.add('on');t=setTimeout(()=>{set(i+1);run()},D)};
as.forEach((a,k)=>{a.addEventListener('pointerenter',e=>{if(e.pointerType!=='mouse')return;held=true;set(k);run()});
  a.addEventListener('focus',()=>{held=true;set(k);run()});
  a.addEventListener('pointerleave',e=>{if(e.pointerType!=='mouse')return;held=false;run()});a.addEventListener('blur',()=>{held=false;run()})});
new IntersectionObserver(([e])=>{vis=e.isIntersecting;run()},{threshold:.4}).observe(g);
document.addEventListener('visibilitychange',run);wide.addEventListener('change',run);})();
</script>
</Base>
