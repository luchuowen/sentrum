---
import Base from '../layouts/Base.astro';
import InnerHero from '../components/InnerHero.astro';
import SceneBroken from '../components/SceneBroken.astro';
---
<Base title="Page not found" description="The page you were looking for isn’t here." noindex>
<InnerHero layout="stack" kicker="404" title="This page <em>isn’t connected.</em>" lede="The link may be old or mistyped. Try one of these instead — or tell us what you were looking for." cta={{ href: '/', label: 'Go to the home page' }} ghost={{ href: '/solutions/', label: 'See all solutions' }}>
  <SceneBroken />
</InnerHero>
<section class="sec"><div class="wrap"><ul class="rows">
  <li><a class="row-a" href="/solutions/"><span class="n">01</span><h2 class="h3">Solutions</h2><p>All 14 services, explained in plain terms.</p><i aria-hidden="true">→</i></a></li>
  <li><a class="row-a" href="/remote-and-satellite/"><span class="n">02</span><h2 class="h3">Remote &amp; satellite</h2><p>Connectivity where the fibre ends.</p><i aria-hidden="true">→</i></a></li>
  <li><a class="row-a" href="/contact/"><span class="n">03</span><h2 class="h3">Contact</h2><p>Tell us what you were looking for.</p><i aria-hidden="true">→</i></a></li>
</ul></div></section>
</Base>
