---
import Base from '../../../layouts/Base.astro';
import InnerHero from '../../../components/InnerHero.astro';
import SceneBuilding from '../../../components/SceneBuilding.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { areas, areaUrl, serviceUrl, type Area } from '../../../data/services';
import { areaScene } from '../../../data/scenes';
import { glyphs } from '../../../data/glyphs';
import { SITE_URL, process } from '../../../data/site';
export function getStaticPaths() { return areas.map((a) => ({ params: { area: a.slug }, props: { a } })); }
const { a } = Astro.props as { a: Area };
const idx = areas.indexOf(a);
const others = areas.filter((x) => x.slug !== a.slug);
const sc = areaScene[a.slug];
const crumbs = [{ href: '/solutions/', label: 'Solutions' }, { href: areaUrl(a), label: a.name }];
const jsonld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' }, ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.label, item: SITE_URL + c.href }))] }];
---
<Base title={a.name} description={`${a.headline} ${a.services.map((s) => s.name).join(', ')} — installed and supported by Sentrum in Kenya and across Africa.`} jsonld={jsonld}>
<InnerHero crumbs={crumbs} kicker={`System 0${idx + 1} / 05`} title={a.name} lede={a.headline} cta={{ href: `/contact/?topic=${a.services[0].slug}`, label: 'Request a site survey →' }} ghost={{ href: '#svc', label: `${a.services.length} services` }}>
  <SceneBuilding id="area" steps={sc.steps} crop={sc.crop} notes={sc.notes} label={`Where ${a.name.toLowerCase()} sit in a building`} />
</InnerHero>

<section class="say" aria-label="In plain terms">
  <div class="wrap say-in">
    <p class="k">In plain terms</p>
    <p class="say-big">{a.plain}</p>
  </div>
</section>

<section class="sec" id="svc" aria-labelledby="svc-h">
  <div class="wrap">
    <header class="sec-head"><div><p class="k">{a.services.length} services in this system</p><h2 id="svc-h">Choose one to see <span>exactly what’s included.</span></h2></div></header>
    <ol class={`svc-cards n${a.services.length}`}>
      {a.services.map((s, i) => (
        <li><a href={serviceUrl(a, s)}>
          <span class="sc-n">0{i + 1}</span>
          <h3>{s.name}</h3>
          <p>{s.plain}</p>
          <ul>{s.deliver.slice(0, 3).map((d) => <li>{d}</li>)}</ul>
          <span class="sc-go">What’s included <i aria-hidden="true">→</i></span>
        </a></li>
      ))}
    </ol>
  </div>
</section>

<section class="band" aria-labelledby="band-h">
  {a.slug === 'networks'
    ? <img src="/img/env-teleport.jpg" alt="" loading="lazy" width="1456" height="1088" style="object-position:50% 40%">
    : <img src={a.img} alt="" loading="lazy" width="1088" height="1456">}
  <div class="band-top wrap"><p class="k">How a job runs</p><h2 id="band-h">Six steps. <span>One team.</span></h2></div>
  <ol class="band-rail">
    {process.map(([t, d], i) => <li style={`--i:${i}`}><b>0{i + 1}</b><strong>{t}</strong><span>{d}</span></li>)}
    <li class="go"><a href="/how-we-work/">How we work <i aria-hidden="true">→</i></a></li>
  </ol>
</section>
<script is:inline>
(()=>{const r=document.querySelector('.band-rail');if(!r)return;new IntersectionObserver(([e],o)=>{if(e.isIntersecting){r.classList.add('run');o.disconnect()}},{threshold:.4}).observe(r)})();
</script>

<section class="sec" aria-labelledby="oth-h">
  <div class="wrap">
    <header class="sec-head"><div><p class="k">Works with</p><h2 id="oth-h">The other four systems</h2></div><a class="more" href="/solutions/">All solutions <span aria-hidden="true">→</span></a></header>
    <ul class="rail">
      {others.map((o) => <li><a href={areaUrl(o)}><svg viewBox="0 0 48 48" aria-hidden="true" set:html={glyphs[o.slug]}></svg><b>{o.slug === 'supply-fabrication-support' ? 'Fabrication &amp; Support' : o.name}</b><span>{o.services.length} services</span><i aria-hidden="true">↗</i></a></li>)}
    </ul>
  </div>
</section>
<CtaBand />
</Base>
