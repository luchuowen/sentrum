---
import Base from '../../layouts/Base.astro';
import InnerHero from '../../components/InnerHero.astro';
import SceneBuilding from '../../components/SceneBuilding.astro';
import CtaBand from '../../components/CtaBand.astro';
import { areas, areaUrl, serviceUrl, allServices } from '../../data/services';
import { glyphs } from '../../data/glyphs';
const find = (slug: string) => allServices.find((s) => s.slug === slug)!;
const problems: [string, string][] = [
  ['The WiFi keeps dropping in our meeting rooms.', 'wifi'],
  ['We’re moving into a new office and need it cabled.', 'structured-cabling'],
  ['Our site is too remote for fibre or mobile data.', 'vsat'],
  ['We need to control who gets into the server room.', 'access-control'],
  ['Power cuts keep taking our systems down.', 'power-ups'],
  ['People can’t hear each other on boardroom calls.', 'audio-visual'],
  ['Our operations room needs one big wall of screens.', 'video-walls'],
  ['We need a mast or bracket made to fit our site.', 'fabrication'],
];
const hl: Record<string, string> = { backbone: 'backbone uplink', security: 'security', rooms: 'rooms', core: 'core', steel: 'steel' };
---
<Base title="Solutions — five systems, one team" description="Networks, security, communications and AV, power and data centre, and supply, fabrication and support — every Sentrum service explained in plain terms.">
<InnerHero layout="stack" compact crumbs={[{ href: '/solutions/', label: 'Solutions' }]} kicker="Solutions" title="Every system a building runs on. <em>One team for all of it.</em>" lede="Pick a system below the drawing, or let it walk you through all five. Each one is explained in plain terms, so you can find what you need without the jargon." ghost={{ href: '#finder', label: 'Start from your problem' }}>
  <SceneBuilding id="hub" cycle groups={{}} crop="0 40 900 600" label="Cross-section of a building showing the five systems Sentrum installs" />
  <div class="hub-tabs" role="group" aria-label="Show a system">
    {areas.map((a, i) => <button type="button" data-hl={hl[a.step]} aria-pressed={i === 0 ? 'true' : 'false'}><i></i><span class="n">0{i + 1}</span>{a.short}</button>)}
  </div>
</InnerHero>

<section class="chap-w" aria-label="The five systems">
  {areas.map((a, i) => (
    <article class={`chap${i % 2 ? ' flip' : ''}`} aria-labelledby={`c-${a.slug}`}>
      <div class="wrap chap-in">
        <figure class="chap-ph"><img src={a.img} alt="" loading={i ? 'lazy' : 'eager'} width="1088" height="1456"><figcaption><span class="n">0{i + 1}</span>{a.short}</figcaption></figure>
        <div class="chap-t">
          <svg class="chap-g" viewBox="0 0 48 48" aria-hidden="true" set:html={glyphs[a.slug]}></svg>
          <h2 id={`c-${a.slug}`}><a href={areaUrl(a)}>{a.name}</a></h2>
          <p class="chap-hl">{a.headline}</p>
          <ul class="chap-l">
            {a.services.map((s) => <li><a href={serviceUrl(a, s)}><b>{s.name}</b><span>{s.plain}</span><i aria-hidden="true">→</i></a></li>)}
          </ul>
          <a class="more" href={areaUrl(a)}>Explore {a.name.toLowerCase()} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </article>
  ))}
</section>

<section class="finder" id="finder" aria-labelledby="fd-h">
  <div class="wrap">
    <header class="sf-head"><p class="k">Not sure what you need?</p><h2 id="fd-h">Tell us the symptom. <span>We’ll name the fix.</span></h2></header>
    <div class="sf-f">
      <button class="sf-box" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="sf-l"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><span class="sf-tx">{problems[0][0]}</span><span class="sf-hint" aria-hidden="true">{problems.length} common problems</span><span class="visually-hidden">Choose a problem</span></button>
      <div class="sf-l" id="sf-l" role="listbox" aria-label="Common problems">
        {problems.map(([q], i) => <button type="button" role="option" aria-selected={i === 0 ? 'true' : 'false'} data-i={i} tabindex="-1">“{q}”</button>)}
      </div>
    </div>
    <div class="sf-r" aria-live="polite">
      {problems.map(([, slug], i) => { const s = find(slug); return (
        <a class={i === 0 ? 'on' : undefined} href={serviceUrl(s.area, s)} data-i={i}>
          <span class="ic"><svg viewBox="0 0 48 48" aria-hidden="true" set:html={glyphs[s.area.slug]}></svg></span>
          <span class="tx"><small>{s.area.name}</small><b>{s.name}</b><em>{s.plain}</em></span>
          <span class="go">See this service <i aria-hidden="true">→</i></span>
        </a>
      ); })}
    </div>
    <p class="sf-note">Something else? <a href="/contact/">Describe it in your own words</a> and an engineer will tell you what it takes.</p>
  </div>
</section>
<CtaBand />
<script is:inline>
(()=>{const svg=document.getElementById('hub'),bs=[...document.querySelectorAll('.hub-tabs button')],RM=matchMedia('(prefers-reduced-motion: reduce)').matches;let i=0,t=0,held=false,vis=true;
const set=k=>{i=(k+bs.length)%bs.length;svg.setAttribute('data-hl',bs[i].dataset.hl);bs.forEach((b,j)=>{b.setAttribute('aria-pressed',j===i);const x=b.firstElementChild;x.style.animation='none';void x.offsetWidth;x.style.animation=''})};
const run=()=>{clearTimeout(t);document.querySelector('.hub-tabs').classList.toggle('held',held||RM);if(RM||held||!vis||document.hidden)return;t=setTimeout(()=>{set(i+1);run()},5000)};
bs.forEach((b,k)=>b.addEventListener('click',()=>{held=true;set(k);run()}));
new IntersectionObserver(([e])=>{vis=e.isIntersecting;run()},{threshold:.3}).observe(svg);document.addEventListener('visibilitychange',run);set(0);run();
const F=document.querySelector('.sf-f'),bx=F.querySelector('.sf-box'),tx=F.querySelector('.sf-tx'),os=[...F.querySelectorAll('[role=option]')],rs=[...document.querySelectorAll('.sf-r a')],Q=os.map(o=>o.textContent.replace(/^“|”$/g,''));let k=0,auto=!RM,tm,seen=false;
const show=j=>{k=j;os.forEach((o,n)=>o.setAttribute('aria-selected',n===j));rs.forEach((r,n)=>r.classList.toggle('on',n===j))};
const type=j=>{clearInterval(tm);if(!auto||!seen)return;const s=Q[j];let n=0;tx.textContent='';F.classList.add('typing');tm=setInterval(()=>{tx.textContent=s.slice(0,++n);if(n>=s.length){clearInterval(tm);F.classList.remove('typing');show(j);tm=setTimeout(()=>type((j+1)%Q.length),2800)}},28)};
const stop=()=>{auto=false;clearInterval(tm);clearTimeout(tm);F.classList.remove('typing')};
const open=o=>{F.classList.toggle('open',o);bx.setAttribute('aria-expanded',o);if(o){stop();tx.textContent=Q[k];os[k].focus()}};
const pick=j=>{stop();show(j);tx.textContent=Q[j];open(false);bx.focus()};
bx.addEventListener('click',()=>open(!F.classList.contains('open')));
bx.addEventListener('keydown',e=>{if(e.key==='ArrowDown'){e.preventDefault();open(true)}});
os.forEach((o,j)=>{o.addEventListener('click',()=>pick(j));o.addEventListener('keydown',e=>{const d={ArrowDown:1,ArrowUp:-1}[e.key];if(d){e.preventDefault();os[(j+d+os.length)%os.length].focus()}else if(e.key==='Escape'){open(false);bx.focus()}else if(e.key==='Tab'){open(false)}})});
document.addEventListener('click',e=>{if(!F.contains(e.target)&&F.classList.contains('open'))open(false)});
new IntersectionObserver(([e],ob)=>{if(e.isIntersecting&&!seen){seen=true;ob.disconnect();setTimeout(()=>type(1),2200)}},{threshold:.5}).observe(F);})();
</script>
</Base>
