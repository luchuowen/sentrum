---
// Remote connectivity landscape: two remote sites link up to a satellite, down to a teleport, and on to head office.
---
<svg class="ln ln-remote" viewBox="0 0 1200 500" role="img" aria-label="A remote site and a field camp send data up to a satellite, which relays it to a teleport ground station and on to head office.">
  <g class="c">
    <path d="M0 430H1200"/><path class="hatch" d="M0 438H1200M0 446H1200"/>
    <path class="thin" d="M0 400C120 380 220 392 330 372S560 360 700 378 980 360 1200 384"/>
    <path class="thin" d="M0 160C300 40 900 40 1200 160" stroke-dasharray="2 8"/>
  </g>
  <g class="c tree">
    <path d="M70 430V380M50 382c20-14 40-14 60 0M40 384c30-24 70-24 100 0"/>
    <path d="M520 430V392M500 394c16-12 32-12 48 0M492 396c24-20 56-20 80 0"/>
    <path d="M1150 430V388M1130 390c16-12 32-12 48 0"/>
  </g>

  <g class="sigs" fill="none">
    <path class="s" id="rs1" d="M232 286L590 98"/>
