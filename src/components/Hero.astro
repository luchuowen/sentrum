---
// Home hero: three service slides. 1 Satellite (rooftop dish) · 2 Security (access control) · 3 Supply & fabrication (workshop).
// Each slide has its own photograph shape and a live canvas layer: signal arcs, a reader scan, weld sparks.
const slides = [
  { k: 'sat', tab: 'Satellite', kick: 'Satellite & networks', h: 'From the rooftop dish to the server room, <em>one team.</em>',
    p: 'Network, satellite, security, AV and power for offices, campuses and remote sites across Kenya and Africa.',
    a: ['Request a site survey →', '/contact/'], b: ['Talk to an engineer', 'tel:+254720288713'],
    img: '/img/rooftop-vsat.jpg', alt: 'An engineer aligning a satellite dish on a Nairobi rooftop', w: 644, hh: 800, pos: '62% 30%' },
  { k: 'sec', tab: 'Security', kick: 'Security', h: 'Doors that know <em>who belongs.</em>',
    p: 'Access control, intrusion detection and cyber security, designed and supported as one system.',
    a: ['Plan a security upgrade →', '/contact/?topic=access-control'], b: ['Security solutions', '/solutions/security/'],
    img: '/img/cap-security.jpg', alt: 'A hand holding a card to an access control reader on a glass door', w: 596, hh: 796, pos: '64% 40%' },
  { k: 'fab', tab: 'Fabrication', kick: 'Supply & fabrication', h: 'Built in our own workshop, <em>mounted on your site.</em>',
    p: 'We fabricate masts, mounts and racks in-house, supply the equipment and support it after go-live.',
    a: ['Ask about fabrication →', '/contact/?topic=fabrication'], b: ['Fabrication & support', '/solutions/supply-fabrication-support/'],
    img: '/img/cap-fabrication.jpg', alt: 'A fabricator welding a steel mount in the workshop', w: 596, hh: 796, pos: '45% 60%' },
];
---
<div class="top">
<section class="rt" id="rt" aria-roledescription="carousel" aria-label="What Sentrum does">
  <div class="rt-stage" id="rt-stage">
    {slides.map((s, i) => (
      <div class={`rt-slide s-${s.k}${i === 0 ? ' on' : ''}`} data-i={i} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}: ${s.tab}`}>
        <canvas class="rt-cv" aria-hidden="true"></canvas>
        <div class="wrap rt-in">
          <div class="rt-copy">
            <p class="rt-k">{s.kick}</p>
            {i === 0 ? <h1 set:html={s.h}></h1> : <h2 set:html={s.h}></h2>}
            <p class="lede">{s.p}</p>
            <div class="act"><a class="cta" href={s.a[1]}>{s.a[0]}</a><a class="cta ghost" href={s.b[1]}>{s.b[0]}</a></div>
          </div>
          <div class="rt-ph"><img src={s.img} alt={s.alt} width={s.w} height={s.hh} style={`object-position:${s.pos}`} /></div>
        </div>
      </div>
    ))}
    <div class="wrap rt-barwrap">
      <div class="rt-bar">
        <div class="rt-tabs" role="group" aria-label="Choose a service">
          {slides.map((s, i) => <button type="button" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}><i></i><b>{String(i + 1).padStart(2, '0')}</b>{s.tab}</button>)}
        </div>
        <button class="rt-pause" type="button" aria-label="Pause the slideshow"><i aria-hidden="true"></i><span>Pause</span></button>
      </div>
    </div>
  </div>
</section>
<div class="wrap">
  <div class="strip">
    <div><b>14 services</b>under one contract</div><div><b>15+ years</b>technical team experience</div>
    <div><b>Wilson Airport, Nairobi</b>serving Kenya and Africa</div>
  </div>
</div>
</div>
<script is:inline>
/* Hero slideshow: three services, 7 s each. Each slide has a live canvas layer over its photograph.
   Pauses on hover/focus of the copy and controls, hidden tab, off-screen and the Pause button.
   Tabs, arrow keys and swipe navigate. Reduced motion: no autoplay and static canvas frames. */
(()=>{
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches,DUR=7000;
const sec=$('#rt'),stage=$('#rt-stage'),slides=$$('.rt-slide',stage),tabs=$$('.rt-tabs button'),pauseBtn=$('.rt-pause'),N=slides.length;
const rafs={};let cur=-1,timer=0,left=DUR,started=0,userPaused=RM,hover=false,visible=true,raf=0,t0=0;
const dpr=()=>Math.min(2,devicePixelRatio||1);
/* map a point of the photograph (fractions of the image, object-fit:cover) to slide pixels */
function imgPt(sl,fx,fy,fb){const b=$('.rt-ph',sl).getBoundingClientRect(),s=sl.getBoundingClientRect(),im=$('img',sl);
  const iw=im.naturalWidth||1,ih=im.naturalHeight||1,pos=(im.style.objectPosition||'50% 50%').split(' ').map(v=>parseFloat(v)/100);
  const k=Math.max(b.width/iw,b.height/ih),ox=(b.width-iw*k)*pos[0],oy=(b.height-ih*k)*pos[1];
  return{x:b.left-s.left+ox+fx*iw*k,y:b.top-s.top+oy+fy*ih*k}}
const boxPt=(sl,fx,fy)=>{const b=$('.rt-ph',sl).getBoundingClientRect(),s=sl.getBoundingClientRect();return{x:b.left-s.left+b.width*fx,y:b.top-s.top+b.height*fy}};
const boxRect=sl=>{const b=$('.rt-ph',sl).getBoundingClientRect(),s=sl.getBoundingClientRect();return{x:b.left-s.left,y:b.top-s.top,w:b.width,h:b.height}};
const ease=x=>1-Math.pow(1-x,3);
function label(c,txt,x,y,al,a){c.save();c.font='500 11px "JetBrains Mono",monospace';c.textBaseline='middle';c.textAlign=al;const w=c.measureText(txt).width,x0=al==='right'?x-w:x;c.fillStyle=`rgba(8,16,24,${.72*a})`;c.fillRect(x0-5,y-9,w+10,18);c.fillStyle=`rgba(225,234,240,${a})`;c.fillText(txt,x,y);c.restore()}
function callout(c,p,dx,dy,txt,al,t,delay){const f=Math.min(1,Math.max(0,(t-delay)/.9)),e=ease(f);
  c.save();c.strokeStyle='rgba(255,255,255,.8)';c.lineWidth=1.2;c.beginPath();c.moveTo(p.x,p.y);c.lineTo(p.x+dx*e,p.y+dy*e);c.stroke();
  c.fillStyle='#fff';c.beginPath();c.arc(p.x,p.y,3.2,0,7);c.fill();c.strokeStyle=`rgba(41,169,225,${.8*(1-(t*.6%1))})`;c.beginPath();c.arc(p.x,p.y,5+(t*.6%1)*12,0,7);c.stroke();c.restore();
  if(f>.85)label(c,txt,p.x+dx+(al==='right'?-8:8),p.y+dy,al,Math.min(1,(f-.85)/.15))}
/* ---- slide 1: signal from the dish to the satellite ---- */
const S1={draw(c,sl,t,W,H){
  const o=imgPt(sl,.60,.34),narrow=W<=960,s=boxPt(sl,narrow?.2:.2,narrow?.06:.07);
  const dx=s.x-o.x,dy=s.y-o.y,L=Math.hypot(dx,dy),ang=Math.atan2(dy,dx),p=Math.min(1,t/1.1);
  for(let k=0;k<4;k++){const f=((t*.28+k/4)%1),r=22+f*Math.min(L*.8,300);c.strokeStyle=`rgba(41,169,225,${.85*(1-f)*p})`;c.lineWidth=1.6;c.beginPath();c.arc(o.x,o.y,r,ang-.42,ang+.42);c.stroke()}
  c.save();c.strokeStyle=`rgba(125,211,245,${.55*p})`;c.lineWidth=1.3;c.setLineDash([5,9]);c.lineDashOffset=-t*30;c.beginPath();c.moveTo(o.x,o.y);c.lineTo(o.x+dx*ease(p),o.y+dy*ease(p));c.stroke();c.restore();
  for(let k=0;k<3;k++){const q=(t*.3+k/3)%1;c.fillStyle=`rgba(255,255,255,${Math.sin(Math.PI*q)*p})`;c.beginPath();c.arc(o.x+dx*q,o.y+dy*q,2.6,0,7);c.fill()}
  c.save();c.globalAlpha=p;c.translate(s.x,s.y);c.rotate(-.5);c.strokeStyle='#fff';c.lineWidth=2;c.lineCap='round';c.beginPath();c.moveTo(-17,0);c.lineTo(17,0);c.stroke();c.fillStyle='#fff';c.beginPath();c.arc(0,0,5,0,7);c.fill();
  const q=(t*.5)%1;c.strokeStyle=`rgba(41,169,225,${.7-.6*q})`;c.beginPath();c.arc(0,0,10+q*18,0,7);c.stroke();c.restore();
  label(c,'SATELLITE',s.x-30,s.y-26,'left',p);
  callout(c,o,46,-4,'VSAT DISH','left',t,.5)}};
/* ---- slide 2: reader, scan and a verified read ---- */
const S2={draw(c,sl,t,W,H){
  const o=imgPt(sl,.64,.41),b=boxRect(sl);
  // scan sweep across the photograph, clipped to its shape
  c.save();c.beginPath();c.rect(b.x,b.y,b.w,b.h);c.clip();
  const sw=((t/3.4)%1),x=b.x-40+sw*(b.w+80),g=c.createLinearGradient(x-90,0,x,0);g.addColorStop(0,'rgba(41,169,225,0)');g.addColorStop(1,'rgba(41,169,225,.28)');
  c.fillStyle=g;c.fillRect(x-90,b.y,90,b.h);c.fillStyle='rgba(160,225,250,.9)';c.fillRect(x-1,b.y,1.5,b.h);c.restore();
  // radio arcs from the reader
  for(let k=0;k<3;k++){const f=((t*.5+k/3)%1),r=14+f*64;c.strokeStyle=`rgba(41,169,225,${.8*(1-f)})`;c.lineWidth=1.5;c.beginPath();c.arc(o.x,o.y,r,0,7);c.stroke()}
  // verify ring then tick, every 4.6 s
  const u=t%4.6,ring=Math.min(1,Math.max(0,(u-.5)/1.1)),tick=Math.min(1,Math.max(0,(u-1.7)/.55)),fade=u>3.4?Math.max(0,1-(u-3.4)/.8):1;
  c.save();c.globalAlpha=fade;c.strokeStyle='#fff';c.lineWidth=2.2;c.lineCap='round';c.lineJoin='round';
  c.beginPath();c.arc(o.x,o.y,24,-Math.PI/2,-Math.PI/2+ring*Math.PI*2);c.stroke();
  if(tick>0){c.strokeStyle='#7DD3F5';c.beginPath();const a=[o.x-9,o.y+1],m=[o.x-2,o.y+8],e=[o.x+11,o.y-8];
    c.moveTo(a[0],a[1]);const t1=Math.min(1,tick*2);c.lineTo(a[0]+(m[0]-a[0])*t1,a[1]+(m[1]-a[1])*t1);if(tick>.5){const t2=(tick-.5)*2;c.lineTo(m[0]+(e[0]-m[0])*t2,m[1]+(e[1]-m[1])*t2)}c.stroke()}
  c.restore();
  callout(c,o,-64,-96,'ACCESS CONTROL','right',t,.4)}};
/* ---- slide 3: weld sparks ---- */
const S3={parts:[],last:0,draw(c,sl,t,W,H,dt){
  const o=imgPt(sl,.55,.63),fl=.75+.25*Math.sin(t*37)*Math.sin(t*11.3);
  const g=c.createRadialGradient(o.x,o.y,0,o.x,o.y,90);g.addColorStop(0,`rgba(255,255,255,${.5*fl})`);g.addColorStop(.25,`rgba(160,225,250,${.28*fl})`);g.addColorStop(1,'rgba(41,169,225,0)');c.fillStyle=g;c.beginPath();c.arc(o.x,o.y,90,0,7);c.fill();
  const n=RM?0:Math.round(dt*60*(2+Math.random()*4));
  for(let i=0;i<n;i++){const a=-Math.PI/2+(Math.random()-.5)*2.5,v=90+Math.random()*300;this.parts.push({x:o.x,y:o.y,vx:Math.cos(a)*v,vy:Math.sin(a)*v,l:.5+Math.random()*.8,age:0})}
  c.save();c.lineCap='round';
  this.parts=this.parts.filter(p=>{p.age+=dt;if(p.age>p.l)return false;const px=p.x,py=p.y;p.vy+=520*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;
    const al=1-p.age/p.l;c.strokeStyle=`rgba(${200+55*al|0},${230+25*al|0},255,${al})`;c.lineWidth=1.6*al+.4;c.beginPath();c.moveTo(px,py);c.lineTo(p.x-p.vx*.012,p.y-p.vy*.012);c.stroke();return true});
  c.restore();
  if(RM&&!this.parts.length){for(let i=0;i<26;i++){const a=-Math.PI/2+(Math.random()-.5)*2.5,v=60+Math.random()*180,tt=Math.random()*.5;c.strokeStyle='rgba(220,240,255,.8)';c.lineWidth=1.3;c.beginPath();c.moveTo(o.x+Math.cos(a)*v*tt,o.y+Math.sin(a)*v*tt+260*tt*tt);c.lineTo(o.x+Math.cos(a)*v*(tt+.03),o.y+Math.sin(a)*v*(tt+.03)+260*(tt+.03)**2);c.stroke()}}
  callout(c,o,74,92,'MADE IN-HOUSE','right',t,.4)}};
const SC=[S1,S2,S3];
/* ---- canvas frame loop (active slide only) ---- */
function sizeCv(sl){const cv=$('canvas',sl),r=sl.getBoundingClientRect(),d=dpr();if(cv.width!==Math.round(r.width*d)||cv.height!==Math.round(r.height*d)){cv.width=Math.round(r.width*d);cv.height=Math.round(r.height*d)}return[cv,r,d]}
let lastTs=0,tAct=0;
function paint(ts){const sl=slides[cur];if(!sl)return;const[cv,r,d]=sizeCv(sl),c=cv.getContext('2d');const dt=Math.min(.05,Math.max(0,(ts-lastTs)/1000)||.016);lastTs=ts;
  if(!userPaused&&!hover&&visible&&!document.hidden||!raf)tAct+=dt;
  c.setTransform(d,0,0,d,0,0);c.clearRect(0,0,r.width,r.height);SC[cur].draw(c,sl,RM?1.6:tAct,r.width,r.height,dt)}
function frame(ts){paint(ts);raf=playing()?requestAnimationFrame(frame):0}
const playing=()=>!RM&&visible&&!document.hidden;
function kick(){if(!raf&&playing())raf=requestAnimationFrame(frame);else if(!playing()){raf=0;paint(performance.now())}}
/* ---- slideshow ---- */
function show(i,{announce=false}={}){i=(i+N)%N;if(i===cur)return;const prev=cur;cur=i;tAct=0;if(SC[i].parts)SC[i].parts.length=0;
  slides.forEach((s,j)=>{const on=j===i;s.classList.toggle('on',on);s.classList.toggle('out',j===prev&&!on);s.inert=!on;on?s.removeAttribute('aria-hidden'):s.setAttribute('aria-hidden','true')});
  tabs.forEach((b,j)=>{b.setAttribute('aria-pressed',j===i);b.classList.toggle('on',j===i);b.classList.toggle('done',j<i);const bar=b.firstElementChild;bar.style.animation='none';void bar.offsetWidth;bar.style.animation=''});
  stage.setAttribute('aria-live',announce||userPaused?'polite':'off');
  fit();left=DUR;schedule();kick();paint(performance.now())}
const running=()=>!userPaused&&!hover&&visible&&!document.hidden;
function schedule(){clearTimeout(timer);timer=0;sec.classList.toggle('paused',!running());if(!running())return;started=performance.now();timer=setTimeout(()=>show(cur+1),left)}
function hold(){if(timer){clearTimeout(timer);timer=0;left=Math.max(300,left-(performance.now()-started))}sec.classList.add('paused')}
function resume(){if(running())schedule()}
function setPaused(p){userPaused=p;pauseBtn.classList.toggle('is-paused',p);pauseBtn.lastElementChild.textContent=p?'Play':'Pause';pauseBtn.setAttribute('aria-label',p?'Play the slideshow':'Pause the slideshow');stage.setAttribute('aria-live',p?'polite':'off');p?hold():resume();kick()}
pauseBtn.addEventListener('click',()=>setPaused(!userPaused));
tabs.forEach((b,j)=>{b.addEventListener('click',()=>{if(j===cur){setPaused(!userPaused)}else{if(userPaused)setPaused(false);show(j,{announce:true})}});
  b.addEventListener('keydown',e=>{const d={ArrowRight:1,ArrowLeft:-1}[e.key];if(!d)return;e.preventDefault();const k=(j+d+N)%N;show(k,{announce:true});tabs[k].focus()})});
[$('.rt-bar'),...slides.map(s=>$('.rt-copy',s))].forEach(el=>{
  el.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'){hover=true;hold()}});el.addEventListener('pointerleave',e=>{if(e.pointerType==='mouse'){hover=false;resume()}});
  el.addEventListener('focusin',()=>{hover=true;hold()});el.addEventListener('focusout',e=>{if(!el.contains(e.relatedTarget)){hover=false;resume()}})});
document.addEventListener('visibilitychange',()=>{document.hidden?hold():resume();kick()});
new IntersectionObserver(([en])=>{visible=en.intersectionRatio>0.35;visible?resume():hold();kick()},{threshold:[0,.35,1]}).observe(sec);
let x0=null,y0=null;stage.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse')return;x0=e.clientX;y0=e.clientY});
stage.addEventListener('pointerup',e=>{if(x0===null)return;const dx=e.clientX-x0,dy=e.clientY-y0;x0=null;if(Math.abs(dx)>48&&Math.abs(dx)>Math.abs(dy)*1.4){if(userPaused)setPaused(false);show(cur+(dx<0?1:-1),{announce:true})}});
stage.addEventListener('pointercancel',()=>{x0=null});
/* mobile: the stage follows the active slide's height */
function fit(){if(!document.documentElement.classList.contains('js'))return;if(innerWidth>960){stage.style.minHeight='';stage.style.height='';return}const a=slides[Math.max(cur,0)];stage.style.height=a.offsetHeight+$('.rt-barwrap',stage).offsetHeight+'px'}
addEventListener('resize',()=>{fit();kick();if(!playing())paint(performance.now())});
$$('img',stage).forEach(im=>{if(!im.complete)im.addEventListener('load',()=>{paint(performance.now())},{once:true})});
document.fonts&&document.fonts.ready.then(()=>{fit();paint(performance.now())});
show(0);if(RM)setPaused(true);else kick();
})();
</script>
