---
// Home hero "X-ray": a plain elevation of a building; a lens reveals the systems inside it.
// The lens tours the six systems by itself and follows the pointer; the index buttons jump to a system.
const stops = [
  { k: 'link', n: 'The link', w: 'Roof · sky', p: "VSAT where fibre doesn't reach: iDirect, SkyEdge and Comtech.", l: [['VSAT & satellite', '/solutions/networks/vsat/']] },
  { k: 'rooms', n: 'The rooms', w: 'Meeting & control rooms', p: 'IP phones, video conferencing, video walls and AV.', l: [['Unified comms', '/solutions/communications-av/unified-communications/'], ['Video walls', '/solutions/communications-av/video-walls/'], ['AV', '/solutions/communications-av/audio-visual/']] },
  { k: 'backbone', n: 'The backbone', w: 'Riser · every floor', p: 'Copper and fibre on every floor, switching, routing and WiFi.', l: [['Structured cabling', '/solutions/networks/structured-cabling/'], ['WiFi', '/solutions/networks/wifi/']] },
  { k: 'core', n: 'The core', w: 'Comms room', p: 'Servers, UPS-backed power, electrical fit-outs and solar.', l: [['Servers', '/solutions/power-data-centre/servers/'], ['Power & UPS', '/solutions/power-data-centre/power-ups/']] },
  { k: 'perimeter', n: 'The perimeter', w: 'Doors · fence · network edge', p: 'Access control, intrusion sensors and firewalls.', l: [['Access control', '/solutions/security/access-control/'], ['Intrusion', '/solutions/security/intrusion-detection/'], ['Cyber', '/solutions/security/cyber-security/']] },
  { k: 'steel', n: 'The steel & support', w: 'Masts · mounts · racks', p: 'Masts and mounts made in-house, equipment supplied, support after go-live.', l: [['Fabrication', '/solutions/supply-fabrication-support/fabrication/'], ['Supply', '/solutions/supply-fabrication-support/it-equipment/'], ['Support', '/solutions/supply-fabrication-support/technical-support/']] },
];
// lattice mast, x centre 650, base 535, top 134
const mast = [];
for (let i = 0; i < 12; i++) {
  const y0 = 535 - (401 * i) / 12, y1 = 535 - (401 * (i + 1)) / 12;
  const w0 = 14 - (6 * i) / 12, w1 = 14 - (6 * (i + 1)) / 12;
  mast.push(`M${650 - w0} ${y0}L${650 + w1} ${y1}M${650 + w0} ${y0}L${650 - w1} ${y1}M${650 - w1} ${y1}H${650 + w1}`);
}
const lattice = `M636 535L644 134M664 535L656 134${mast.join('')}`;
const fence = (x0) => Array.from({ length: 5 }, (_, i) => `M${x0 + i * 15} 535V498`).join('') + `M${x0} 498H${x0 + 60}`;
---
<div class="top">
<section class="xr wrap" id="xr" aria-label="What Sentrum does">
  <div class="xr-t">
    <p class="xr-k">Wilson Airport · Nairobi</p>
    <h1 id="h1">The other half <em>of your building.</em></h1>
    <p class="lede">The network, satellite link, security, AV and power that your building runs on. Installed and supported by one engineering team.</p>
    <div class="act"><a class="cta" href="/contact/">Request a site survey →</a><a class="cta ghost" href="tel:+254720288713">Talk to an engineer</a></div>
  </div>

  <div class="xr-f">
    <div class="xr-fig" id="xr-fig">
      <svg class="xr-base" viewBox="30 40 720 570" role="img" aria-label="Cross-section of a three-storey commercial building with a mast beside it. A lens moves over it and shows the systems inside: satellite link, rooms, backbone, core, perimeter and steel.">
        <defs>
          <g id="xr-shell" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 535H740"/><path class="th" d="M30 544H210M300 544H520M590 544H730"/>
            <path d="M140 535V160H560V535M132 160H568V152H132Z"/>
            <path d="M140 285H560M140 410H560"/>
            <rect class="th" x="168" y="203" width="46" height="58" rx="3"/><rect class="th" x="248" y="203" width="46" height="58" rx="3"/><rect class="th" x="328" y="203" width="46" height="58" rx="3"/><rect class="th" x="408" y="203" width="46" height="58" rx="3"/><rect class="th" x="488" y="203" width="46" height="58" rx="3"/>
            <rect class="th" x="168" y="328" width="46" height="58" rx="3"/><rect class="th" x="248" y="328" width="46" height="58" rx="3"/><rect class="th" x="328" y="328" width="46" height="58" rx="3"/><rect class="th" x="408" y="328" width="46" height="58" rx="3"/><rect class="th" x="488" y="328" width="46" height="58" rx="3"/>
            <path class="th" d="M172 440H300M172 452H300M172 464H300M172 476H300"/>
            <path d="M490 535V462H534V535"/>
            <path d={lattice}/>
            <path d={fence(66)}/><path d={fence(566)}/>
          </g>
        </defs>
        <use href="#xr-shell" class="xr-dim"/>
        <circle class="xr-sat0" cx="690" cy="68" r="3"/>
      </svg>
      <div class="xr-lit" aria-hidden="true">
        <svg viewBox="30 40 720 570">
          <rect class="xr-fill" x="-100" y="-100" width="960" height="900"/>
          <use href="#xr-shell" class="xr-bright"/>
          <!-- link: roof dish, beam, satellite, mast dish -->
          <g class="sy" id="sy-link">
            <path d="M235 160V138"/><g transform="translate(235 138) rotate(36)"><path d="M-23 -3Q0 24 23 -3"/><path d="M0 9V-23"/><circle class="f" cx="0" cy="-23" r="2.6"/></g>
            <path class="beam" d="M249 118L690 68"/>
            <circle class="f" cx="690" cy="68" r="5"/><path d="M672 68h36M690 60v16"/><circle class="ring" cx="690" cy="68" r="10"/>
            <g transform="translate(650 134)"><path d="M-20 4Q0 -20 20 4"/><path d="M0 -4V4"/></g><path class="beam" d="M652 118L688 72"/>
            <path d="M385 160l18-20h38l-18 20ZM441 160l18-20h38l-18 20ZM497 160l18-20h38l-18 20Z"/><path d="M394 150h38M450 150h38M506 150h38"/>
          </g>
          <!-- rooms: video wall, camera, table -->
          <g class="sy" id="sy-rooms">
            <rect x="176" y="190" width="112" height="58" rx="3"/><path d="M213 190v58M250 190v58M176 219h112"/>
            <circle class="f" cx="232" cy="180" r="3"/><path d="M226 172h12"/>
            <ellipse cx="430" cy="262" rx="64" ry="9"/><circle class="f" cx="388" cy="240" r="3.4"/><circle class="f" cx="414" cy="234" r="3.4"/><circle class="f" cx="442" cy="234" r="3.4"/><circle class="f" cx="470" cy="240" r="3.4"/>
            <path class="arc a1" d="M488 212q12 10 0 20"/><path class="arc a2" d="M498 204q18 18 0 36"/>
          </g>
          <!-- backbone: riser, trays, access points -->
          <g class="sy" id="sy-backbone">
            <path class="cab" d="M235 160V176H175V520"/><path class="flow" d="M235 160V176H175V520"/>
            <path class="cab" d="M175 300H540"/><path class="flow" d="M175 300H540"/>
            <path class="cab" d="M175 396H540"/><path class="flow f2" d="M175 396H540"/>
            <circle class="f" cx="175" cy="300" r="3.5"/><circle class="f" cx="175" cy="396" r="3.5"/>
            <g class="ap"><circle class="f" cx="270" cy="312" r="4.5"/><path class="arc a1" d="M258 322q12 9 24 0"/><path class="arc a2" d="M250 330q20 16 40 0"/></g>
            <g class="ap"><circle class="f" cx="380" cy="312" r="4.5"/><path class="arc a1" d="M368 322q12 9 24 0"/><path class="arc a2" d="M360 330q20 16 40 0"/></g>
            <g class="ap"><circle class="f" cx="480" cy="312" r="4.5"/><path class="arc a1" d="M468 322q12 9 24 0"/><path class="arc a2" d="M460 330q20 16 40 0"/></g>
          </g>
          <!-- core: racks, UPS, power -->
          <g class="sy" id="sy-core">
            <rect x="188" y="436" width="26" height="86" rx="3"/><rect x="220" y="436" width="26" height="86" rx="3"/><rect x="252" y="436" width="26" height="86" rx="3"/><rect x="284" y="436" width="26" height="86" rx="3"/>
            <circle class="f led l1" cx="201" cy="450" r="1.8"/><circle class="f led l2" cx="201" cy="460" r="1.8"/><circle class="f led l2" cx="233" cy="450" r="1.8"/><circle class="f led l3" cx="233" cy="460" r="1.8"/><circle class="f led l3" cx="265" cy="450" r="1.8"/><circle class="f led l1" cx="265" cy="460" r="1.8"/><circle class="f led l1" cx="297" cy="450" r="1.8"/><circle class="f led l2" cx="297" cy="460" r="1.8"/>
            <path d="M192 480h18M224 480h18M256 480h18M288 480h18M192 492h18M224 492h18M256 492h18M288 492h18"/>
            <rect x="338" y="478" width="66" height="44" rx="4"/><path d="M356 478v-6h8v6M378 478v-6h8v6"/><path d="M352 500h14M382 500h14M389 493v14"/>
            <path class="cab" d="M175 520H188"/>
            <path class="pw" d="M545 160V506H404"/>
          </g>
          <!-- perimeter: reader, fence sensors, firewall -->
          <g class="sy" id="sy-perimeter">
            <rect x="472" y="484" width="10" height="18" rx="2"/><circle class="f" cx="477" cy="490" r="1.8"/><path class="arc a1" d="M466 480q-8 13 0 26"/>
            <path class="sens" d="M66 498H126M566 498H626"/>
            <circle class="f" cx="66" cy="498" r="3"/><circle class="f" cx="126" cy="498" r="3"/><circle class="f" cx="566" cy="498" r="3"/><circle class="f" cx="626" cy="498" r="3"/>
            <path class="cab" d="M175 520H20"/><path class="flow f2" d="M175 520H20"/>
            <path d="M100 506l12 4v8c0 7-5 12-12 15-7-3-12-8-12-15v-8Z"/>
          </g>
          <!-- steel: mast, mounts, rack -->
          <g class="sy" id="sy-steel">
            <path d="M624 290h26M650 262v28M676 380h-26M650 352v28"/>
            <path d="M610 535h80M618 535V520M682 535V520"/><circle class="f" cx="650" cy="290" r="3"/><circle class="f" cx="650" cy="380" r="3"/>
            <g transform="translate(650 262)"><path d="M-18 6Q0 -16 18 6"/><path d="M0 -2V6"/></g>
          </g>
        </svg>
      </div>
      <div class="xr-lens" aria-hidden="true"></div>
      <p class="xr-hint" aria-hidden="true">Move the lens</p>
      <p class="xr-coord" aria-hidden="true">1.3204° S · 36.8127° E</p>
    </div>
  </div>
    <div class="xr-ui" id="xr-ui">
      <div class="xr-idx" role="group" aria-label="Systems we deliver">
        {stops.map((s, i) => <button type="button" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}><i></i><b>{String(i + 1).padStart(2, '0')}</b>{s.n.replace('The ', '').replace(' & support', '')}</button>)}
      </div>
      <div class="xr-cap" id="xr-cap" aria-live="off">
        {stops.map((s, i) => (
          <div class="xr-c" data-i={i} data-on={i === 0 ? '1' : '0'}>
            <p class="xr-w">{s.w}</p>
            <h2>{s.n}</h2>
            <p>{s.p}</p>
            <ul>{s.l.map(([t, h]) => <li><a href={h}>{t}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <button class="xr-pause" type="button" aria-label="Pause the tour"><i aria-hidden="true"></i><span>Pause</span></button>
    </div>
</section>
<div class="wrap">
  <div class="strip">
    <div><b>14 services</b>under one contract</div><div><b>15+ years</b>technical team experience</div>
    <div><b>Own fabrication</b>masts, mounts and racks</div><div><b>Wilson Airport, Nairobi</b>serving Kenya and Africa</div>
  </div>
</div>
</div>
<script is:inline>
/* X-ray hero: a lens tours six systems by itself (5.5 s each) and follows the pointer.
   Index buttons jump to a system. Pauses on hover/focus of the controls, hidden tab, off-screen and the Pause button.
   Reduced motion: no automatic movement; the lens still follows the pointer. */
(()=>{
const $=(s,r=document)=>r.querySelector(s),$$=(s,r=document)=>[...r.querySelectorAll(s)];
const sec=$('#xr'),fig=$('#xr-fig'),base=$('.xr-base',fig),lit=$('.xr-lit',fig),lens=$('.xr-lens',fig),hint=$('.xr-hint',fig);
const btns=$$('.xr-idx button'),caps=$$('.xr-c'),capBox=$('#xr-cap'),pauseBtn=$('.xr-pause'),ui=$('#xr-ui');
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const STOPS=[[320,128],[320,232],[340,352],[270,470],[520,480],[640,330]],N=STOPS.length,DUR=5500;
const VB={x:30,y:40,w:720,h:570};const VBS={d:[30,40,720,570],m:[105,110,610,500]};
let ox=0,cur=-1,pos={...{x:STOPS[0][0],y:STOPS[0][1]}},tgt={...pos},raf=0,timer=0,userPaused=RM,hover=false,visible=true,pointerOn=false,idleT=0,scale=1,R=140;
const px=()=>{const m=innerWidth<=960,v=VBS[m?'m':'d'];if(VB.x!==v[0]){[VB.x,VB.y,VB.w,VB.h]=v;const a=v.join(' ');base.setAttribute('viewBox',a);$('svg',lit).setAttribute('viewBox',a)}const r=base.getBoundingClientRect();scale=Math.min(r.width/VB.w,r.height/VB.h);ox=(r.width-VB.w*scale)/2;R=m?150:168;return r};
function apply(){const s=scale,rx=ox+(pos.x-VB.x)*s,ry=(pos.y-VB.y)*s,rr=R*s;
  fig.style.setProperty('--lx',rx+'px');fig.style.setProperty('--ly',ry+'px');fig.style.setProperty('--r',rr+'px');
  lens.style.width=lens.style.height=rr*2+'px';lens.style.transform=`translate(${rx-rr}px,${ry-rr}px)`}
function loop(){const k=RM?1:.14;pos.x+=(tgt.x-pos.x)*k;pos.y+=(tgt.y-pos.y)*k;apply();
  if(Math.hypot(tgt.x-pos.x,tgt.y-pos.y)>.25){raf=requestAnimationFrame(loop)}else{pos.x=tgt.x;pos.y=tgt.y;apply();raf=0}}
const go=()=>{if(!raf)raf=requestAnimationFrame(loop)};
function setActive(i,{announce=false}={}){if(i===cur)return;cur=i;
  btns.forEach((b,j)=>{b.setAttribute('aria-pressed',j===i);b.classList.toggle('on',j===i);b.classList.toggle('done',j<i);const bar=b.firstElementChild;bar.style.animation='none';void bar.offsetWidth;bar.style.animation=''});
  caps.forEach((c,j)=>c.dataset.on=j===i?'1':'0');
  $$('.sy',lit).forEach((g,j)=>g.classList.toggle('on',j===i));
  capBox.setAttribute('aria-live',announce||userPaused?'polite':'off')}
function toStop(i,opts){i=(i+N)%N;tgt.x=STOPS[i][0];tgt.y=STOPS[i][1];go();setActive(i,opts)}
const nearest=()=>{let b=0,d=1e9;STOPS.forEach((s,i)=>{const e=Math.hypot(s[0]-tgt.x,s[1]-tgt.y);if(e<d){d=e;b=i}});return b};
/* tour */
const running=()=>!userPaused&&!hover&&!pointerOn&&visible&&!document.hidden;
function schedule(){clearTimeout(timer);sec.classList.toggle('paused',!running());if(!running())return;timer=setTimeout(()=>{toStop(cur+1);schedule()},DUR)}
function setPaused(p){userPaused=p;pauseBtn.classList.toggle('is-paused',p);pauseBtn.lastElementChild.textContent=p?'Play':'Pause';pauseBtn.setAttribute('aria-label',p?'Play the tour':'Pause the tour');capBox.setAttribute('aria-live',p?'polite':'off');schedule()}
pauseBtn.addEventListener('click',()=>setPaused(!userPaused));
btns.forEach((b,j)=>{b.addEventListener('click',()=>{toStop(j,{announce:true});schedule()});
  b.addEventListener('keydown',e=>{const d={ArrowRight:1,ArrowDown:1,ArrowLeft:-1,ArrowUp:-1}[e.key];if(!d)return;e.preventDefault();const k=(j+d+N)%N;toStop(k,{announce:true});btns[k].focus();schedule()})});
/* pointer: the lens follows the cursor */
function unit(e){const r=px();return{x:Math.max(VB.x,Math.min(VB.x+VB.w,VB.x+(e.clientX-r.left-ox)/scale)),y:Math.max(VB.y,Math.min(VB.y+VB.h,VB.y+(e.clientY-r.top)/scale))}}
function follow(e){const u=unit(e);tgt.x=u.x;tgt.y=u.y;go();setActive(nearest(),{announce:false});sec.classList.add('touched')}
fig.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'){pointerOn=true;clearTimeout(idleT);schedule();follow(e)}});
fig.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'||pointerOn||e.buttons){follow(e)}});
fig.addEventListener('pointerleave',e=>{if(e.pointerType!=='mouse')return;pointerOn=false;clearTimeout(idleT);idleT=setTimeout(()=>{toStop(nearest());schedule()},900)});
fig.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse')return;pointerOn=true;follow(e);fig.setPointerCapture(e.pointerId)});
fig.addEventListener('pointerup',e=>{if(e.pointerType==='mouse')return;pointerOn=false;idleT=setTimeout(()=>{toStop(nearest());schedule()},2500)});
fig.addEventListener('pointercancel',()=>{pointerOn=false;schedule()});
/* pause while reading or using the controls */
[ui].forEach(el=>{el.addEventListener('pointerenter',e=>{if(e.pointerType==='mouse'){hover=true;schedule()}});el.addEventListener('pointerleave',e=>{if(e.pointerType==='mouse'){hover=false;schedule()}});
  el.addEventListener('focusin',()=>{hover=true;schedule()});el.addEventListener('focusout',e=>{if(!el.contains(e.relatedTarget)){hover=false;schedule()}})});
document.addEventListener('visibilitychange',schedule);
new IntersectionObserver(([en])=>{visible=en.intersectionRatio>0.35;schedule()},{threshold:[0,.35,1]}).observe(sec);
/* height: keep the caption box stable */
function fit(){px();capBox.style.minHeight=Math.max(...caps.map(c=>{const d=c.dataset.on;c.dataset.on='1';c.style.position='static';const h=c.offsetHeight;c.style.position='';c.dataset.on=d;return h}))+'px';apply()}
addEventListener('resize',()=>{fit()});document.fonts&&document.fonts.ready.then(fit);
px();fit();apply();setActive(0);toStop(0);sec.classList.add('ready');
if(RM)setPaused(true);else schedule();
})();
</script>
