---
import '../styles/global.css';
import { SITE_URL, company, nav } from '../data/site';
import { areas, areaUrl } from '../data/services';
interface Props { title: string; description: string; jsonld?: object[]; noindex?: boolean }
const { title, description, jsonld = [], noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE_URL).href;
const fullTitle = path === '/' ? title : `${title} | Sentrum`;
const desc = description.length <= 155 ? description : description.slice(0, 154).replace(/\s+\S*$/, '').replace(/[,;:—–-]$/, '') + '…';
const org = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': `${SITE_URL}/#org`,
  name: company.name, alternateName: company.short, url: SITE_URL + '/', logo: `${SITE_URL}/brand/sentrum-logo.svg`,
  image: `${SITE_URL}/og.jpg`, telephone: company.phone, email: company.email,
  address: { '@type': 'PostalAddress', streetAddress: company.address, addressLocality: company.city, addressCountry: 'KE' },
  geo: { '@type': 'GeoCoordinates', latitude: company.geo.lat, longitude: company.geo.lng },
  areaServed: ['Kenya', 'Africa'],
};
const year = new Date().getFullYear();
const isOn = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<!doctype html>
<html lang="en-KE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={desc}>
{!noindex && <link rel="canonical" href={canonical}>}
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#0B1620">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/instrument-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<meta property="og:type" content="website"><meta property="og:site_name" content="Sentrum Communications">
<meta property="og:title" content={fullTitle}><meta property="og:description" content={description}>
<meta property="og:url" content={canonical}><meta property="og:image" content={`${SITE_URL}/og.jpg`}>
<meta property="og:locale" content="en_KE"><meta name="twitter:card" content="summary_large_image">
<script is:inline>document.documentElement.classList.add('js')</script>
<script type="application/ld+json" set:html={JSON.stringify([org, ...jsonld])} />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="hdr"><div class="wrap">
  <a href="/" aria-label="Sentrum Communications — home"><img src="/brand/sentrum-logo-white.svg" alt="Sentrum Communications" width="148" height="40"></a>
  <nav class="nav" id="nav" aria-label="Primary">
    {nav.map((n) => <a href={n.href} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <a class="cta" href="/contact/">Request a site survey →</a>
  <button class="menu" aria-expanded="false" aria-controls="nav">Menu</button>
</div></header>
<main id="main"><slot /></main>
<footer><div class="wrap g">
  <div><img src="/brand/sentrum-logo-white.svg" alt="Sentrum Communications" width="140" height="38" loading="lazy"><p>Networks, satellite, security, AV and power — designed, installed and supported by one team.</p></div>
  <div><h2 class="fh">Solutions</h2><ul>{areas.map((a) => <li><a href={areaUrl(a)}>{a.name}</a></li>)}</ul></div>
  <div><h2 class="fh">Company</h2><ul><li><a href="/company/">About us</a></li><li><a href="/how-we-work/">How we work</a></li><li><a href="/remote-and-satellite/">Remote &amp; satellite</a></li><li><a href="/support/">Support</a></li><li><a href="/contact/">Contact</a></li></ul></div>
  <div><h2 class="fh">Head office</h2><p>{company.address}<br>{company.city}, {company.country}</p><p class="fc"><a href={`tel:${company.tel}`}>{company.phone}</a><br><a href={`mailto:${company.email}`}>{company.email}</a></p></div>
  <div class="legal"><span>© {year} Sentrum Communication</span><a href="/privacy/">Privacy</a><span class="credit">Designed by NAVAC GLOBAL</span></div>
</div></footer>
<nav class="mbar" aria-label="Quick contact"><a href={`tel:${company.tel}`}>Call</a><a href={`mailto:${company.email}`}>Email</a><a href="/contact/">Site survey</a></nav>
<script is:inline>
(()=>{const m=document.querySelector('.menu'),set=o=>{document.body.classList.toggle('nav-open',o);m.setAttribute('aria-expanded',o);m.textContent=o?'Close':'Menu'};
m.addEventListener('click',()=>set(!document.body.classList.contains('nav-open')));
addEventListener('keydown',e=>{if(!document.body.classList.contains('nav-open'))return;if(e.key==='Escape'){set(false);m.focus();return}
if(e.key==='Tab'){const f=[m,...document.querySelectorAll('.nav a')],i=f.indexOf(document.activeElement);if(e.shiftKey&&i<=0){e.preventDefault();f[f.length-1].focus()}else if(!e.shiftKey&&(i===f.length-1||i<0)){e.preventDefault();f[0].focus()}}});
document.querySelectorAll('.nav a').forEach(a=>a.addEventListener('click',()=>set(false)));})();
</script>
</body>
</html>
