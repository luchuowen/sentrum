---
import '../styles/global.css';
import '../styles/inner.css';
import { SITE_URL, company, nav, social } from '../data/site';
import fs from 'node:fs';
const socialIcons = social.map((x) => ({ ...x, svg: fs.readFileSync(`src/icons/social/${x.icon}.svg`, 'utf8') }));
import { areas, areaUrl, serviceUrl } from '../data/services';
import { glyphs } from '../data/glyphs';
const menuLine: Record<string, string> = { networks: 'Cabling, WiFi and VSAT', security: 'Access, intrusion and cyber', 'communications-av': 'Phones, video walls and AV', 'power-data-centre': 'Servers and backup power', 'supply-fabrication-support': 'Equipment, masts and support' };
interface Props { title: string; description: string; jsonld?: object[]; noindex?: boolean }
const { title, description, jsonld = [], noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE_URL).href;
const fullTitle = path === '/' ? title : `${title} | Sentrum`;
const desc = description.length <= 155 ? description : description.slice(0, 154).replace(/\s+\S*$/, '').replace(/[,;:—–-]$/, '') + '…';
const org = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': `${SITE_URL}/#org`,
  name: company.name, alternateName: company.short, url: SITE_URL + '/', logo: `${SITE_URL}/brand/sentrum-logo.svg`,
  image: `${SITE_URL}/og.jpg`, telephone: company.phone, email: company.email,
  address: { '@type': 'PostalAddress', streetAddress: company.address, addressLocality: company.city, addressCountry: 'KE' },
  geo: { '@type': 'GeoCoordinates', latitude: company.geo.lat, longitude: company.geo.lng },
  areaServed: ['Kenya', 'Africa'],
};
const year = new Date().getFullYear();
const isOn = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<!doctype html>
<html lang="en-KE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={desc}>
{!noindex && <link rel="canonical" href={canonical}>}
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#0B1620">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/instrument-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/instrument-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<meta property="og:type" content="website"><meta property="og:site_name" content="Sentrum Communications">
<meta property="og:title" content={fullTitle}><meta property="og:description" content={description}>
<meta property="og:url" content={canonical}><meta property="og:image" content={`${SITE_URL}/og.jpg`}><meta property="og:image:secure_url" content={`${SITE_URL}/og.jpg`}><meta property="og:image:type" content="image/jpeg"><meta property="og:image:width" content="2400"><meta property="og:image:height" content="1260"><meta property="og:image:alt" content="Sentrum Communications — networks, VSAT, security, AV and power for businesses in Kenya and Africa"><meta name="twitter:image" content={`${SITE_URL}/og.jpg`}>
<meta property="og:locale" content="en_KE"><meta name="twitter:card" content="summary_large_image">
<script is:inline>document.documentElement.classList.add('js')</script>
<script type="application/ld+json" set:html={JSON.stringify([org, ...jsonld])} />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="hdr"><div class="wrap">
  <a href="/" aria-label="Sentrum Communications — home"><img src="/brand/sentrum-logo-white.svg" alt="Sentrum Communications" width="148" height="40"></a>
  <nav class="nav" id="nav" aria-label="Primary">
    {nav.map((n) => n.href === '/solutions/' ? (
      <div class="sm">
        <a class="sm-t" href={n.href} aria-current={isOn(n.href) ? 'page' : undefined} aria-expanded="false" aria-controls="sm-p">{n.label}<i aria-hidden="true"></i></a>
        <div class="sm-p" id="sm-p">
          <div class="sm-l">
            {areas.map((a, i) => <a href={areaUrl(a)} data-i={i} class={i === 0 ? 'on' : undefined}><svg class="sm-g" viewBox="0 0 48 48" aria-hidden="true" set:html={glyphs[a.slug]}></svg><span><b>{a.name}</b><em>{menuLine[a.slug]}</em></span><i aria-hidden="true">›</i></a>)}
            <a class="sm-all" href="/solutions/">See all solutions <i aria-hidden="true">→</i></a>
          </div>
          <div class="sm-r">
            {areas.map((a, i) => <div class={i === 0 ? 'sm-pn on' : 'sm-pn'} data-i={i}><p>{a.services.length} services</p><ul>{a.services.map((s) => <li><a href={serviceUrl(a, s)}>{s.name}<i aria-hidden="true">→</i></a></li>)}</ul><a class="sm-ov" href={areaUrl(a)}>{a.name} overview →</a></div>)}
          </div>
        </div>
        <div class="sm-m">
          {areas.map((a) => <details><summary><svg class="sm-g" viewBox="0 0 48 48" aria-hidden="true" set:html={glyphs[a.slug]}></svg><b>{a.name}</b><i aria-hidden="true"></i></summary><ul><li><a href={areaUrl(a)}>Overview</a></li>{a.services.map((s) => <li><a href={serviceUrl(a, s)}>{s.name}</a></li>)}</ul></details>)}
          <a class="sm-all" href="/solutions/">See all solutions <i aria-hidden="true">→</i></a>
        </div>
      </div>
    ) : <a href={n.href} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <a class="cta" href="/contact/">Request a site survey →</a>
  <button class="menu" aria-expanded="false" aria-controls="msheet" aria-label="Open menu"><i></i><i></i></button>
</div>
<div class="msheet" id="msheet">
  <p class="ms-k">Solutions</p>
  <div class="ms-sys">
    {areas.map((a) => <a href={areaUrl(a)} aria-current={path.startsWith(areaUrl(a)) ? 'page' : undefined}><svg viewBox="0 0 48 48" aria-hidden="true" set:html={glyphs[a.slug]}></svg><span><b>{a.name}</b><em>{menuLine[a.slug]}</em></span><i aria-hidden="true">›</i></a>)}
  </div>
  <div class="ms-grid">
    {nav.filter((n) => n.href !== '/solutions/').map((n) => <a href={n.href} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}<i aria-hidden="true">↗</i></a>)}
  </div>
  <a class="ms-cta" href="/contact/">Request a site survey <i aria-hidden="true">→</i></a>
  <div class="ms-ct"><a href={`tel:${company.tel}`}>Call</a><a href={`mailto:${company.email}`}>Email</a></div>
</div></header>
<main id="main"><slot /></main>
<footer><div class="wrap g">
  <div class="fb"><img src="/brand/sentrum-logo-white.svg" alt="Sentrum Communications" width="140" height="38" loading="lazy"><p>Networks, satellite communications, security, audio-visual systems and power solutions for businesses across Kenya and Africa.</p><ul class="so">{socialIcons.map((x) => <li><a href={x.href} aria-label={`Sentrum on ${x.name}`} target={x.href === '#' ? undefined : '_blank'} rel={x.href === '#' ? undefined : 'noopener'}><span set:html={x.svg}></span><span class="tt" aria-hidden="true">{x.name}</span></a></li>)}</ul></div>
  <details class="fd" open><summary class="fh">Solutions<i aria-hidden="true"></i></summary><div class="fbody"><ul>{areas.map((a) => <li><a href={areaUrl(a)}>{a.name}</a></li>)}</ul></div></details>
  <details class="fd" open><summary class="fh">Company<i aria-hidden="true"></i></summary><div class="fbody"><ul><li><a href="/company/">About us</a></li><li><a href="/how-we-work/">How we work</a></li><li><a href="/remote-and-satellite/">Remote &amp; satellite</a></li><li><a href="/support/">Support</a></li><li><a href="/contact/">Contact</a></li></ul></div></details>
  <details class="fd" open><summary class="fh">Head office<i aria-hidden="true"></i></summary><div class="fbody"><p>{company.address}<br>{company.city}, {company.country}</p><p class="fc"><a href={`tel:${company.tel}`}>{company.phone}</a><br><a href={`mailto:${company.email}`}>{company.email}</a></p></div></details>
  <div class="legal"><span>© {year} Sentrum Communication</span><span class="credit">Designed by <a href="https://navac.co.ke" target="_blank" rel="noopener">NAVAC GLOBAL</a></span></div>
</div></footer>
<script is:inline>
/* Footer categories: always open on wide screens; on phones they start closed and toggle. */
(()=>{const ds=[...document.querySelectorAll('footer .fd')],mq=matchMedia('(max-width:640px)');
const sync=()=>ds.forEach(d=>{if(!mq.matches)d.open=true;else if(!d.dataset.t)d.open=false});
ds.forEach(d=>d.querySelector('summary').addEventListener('click',e=>{if(!mq.matches){e.preventDefault();return}d.dataset.t=1}));
mq.addEventListener('change',sync);sync()})();
</script>
<nav class="mbar" aria-label="Quick contact"><a href={`tel:${company.tel}`}>Call</a><a href={`mailto:${company.email}`}>Email</a><a href="/contact/">Site survey</a></nav>
<script is:inline>
(()=>{const m=document.querySelector('.menu'),set=o=>{document.body.classList.toggle('nav-open',o);m.setAttribute('aria-expanded',o);m.setAttribute('aria-label',o?'Close menu':'Open menu')};
m.addEventListener('click',()=>set(!document.body.classList.contains('nav-open')));
addEventListener('keydown',e=>{if(!document.body.classList.contains('nav-open'))return;if(e.key==='Escape'){set(false);m.focus();return}
if(e.key==='Tab'){const f=[m,...document.querySelectorAll('.msheet a')],i=f.indexOf(document.activeElement);if(e.shiftKey&&i<=0){e.preventDefault();f[f.length-1].focus()}else if(!e.shiftKey&&(i===f.length-1||i<0)){e.preventDefault();f[0].focus()}}});
document.querySelectorAll('.nav a:not(.sm-t),.msheet a').forEach(a=>a.addEventListener('click',()=>set(false)));document.addEventListener('click',e=>{if(document.body.classList.contains('nav-open')&&!e.target.closest('.msheet,.menu'))set(false)});
const sm=document.querySelector('.sm');if(sm){const st=sm.querySelector('.sm-t'),mq=matchMedia('(max-width:960px)'),ls=[...sm.querySelectorAll('.sm-l a[data-i]')],ps=[...sm.querySelectorAll('.sm-pn')];let tm;
const op=o=>{clearTimeout(tm);sm.classList.toggle('open',o);st.setAttribute('aria-expanded',o)};
const pick=i=>{ls.forEach((x,j)=>x.classList.toggle('on',j==i));ps.forEach((x,j)=>x.classList.toggle('on',j==i))};
ls.forEach((a,i)=>{a.addEventListener('mouseenter',()=>pick(i));a.addEventListener('focus',()=>pick(i))});
sm.addEventListener('mouseenter',()=>{if(!mq.matches)op(true)});sm.addEventListener('mouseleave',()=>{if(!mq.matches)tm=setTimeout(()=>op(false),160)});
sm.addEventListener('focusin',()=>{if(!mq.matches)op(true)});sm.addEventListener('focusout',e=>{if(!sm.contains(e.relatedTarget))op(false)});
st.addEventListener('click',e=>{if(mq.matches){e.preventDefault();op(!sm.classList.contains('open'))}});
st.addEventListener('keydown',e=>{if(!mq.matches&&e.key==='ArrowDown'){e.preventDefault();op(true);requestAnimationFrame(()=>ls[0].focus())}});
sm.addEventListener('keydown',e=>{if(e.key==='Escape'&&sm.classList.contains('open')&&!mq.matches){op(false);st.focus()}});
mq.addEventListener('change',()=>op(false));}
})();
</script>
</body>
</html>
